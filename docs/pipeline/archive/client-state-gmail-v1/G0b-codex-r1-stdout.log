    def append(self, row: ObservationRow) -> None:
        # G-LEDGER-1: read-whole + rewrite-whole through atomic_write
        # (temp + os.replace) -- never a bare open("a"); a crash mid-write
        # leaves either the old file or the new one, never a torn line.
        rows = self._read_rows()
        rows.append(row)
        lines = [json.dumps(_row_to_dict(r), sort_keys=True) for r in rows]
        data = ("\n".join(lines) + "\n").encode("utf-8") if lines else b""
        atomic_write(self.path, data)

    def latest(self, source_ref: str) -> ObservationRow | None:
        result: ObservationRow | None = None
        for row in self._read_rows():
            if row.source_ref == source_ref:
                result = row
        return result

    def is_terminal(self, source_ref: str, digest: str) -> bool:
        # G-LEDGER-2: terminal iff the LATEST row for source_ref carries the
        # SAME digest AND every resolution outcome on it is "filed". A later
        # row with a different digest supersedes and is never terminal for
        # either digest until it is itself fully filed.
        row = self.latest(source_ref)
        if row is None or row.content_digest != digest:
            return False
        if not row.resolutions:
            return False
        return all(r.outcome == "filed" for r in row.resolutions)

    def rows_since(self, since_iso: str) -> list[ObservationRow]:
        return [r for r in self._read_rows() if r.observed_at >= since_iso]

    def distinct_refs(self) -> set[str]:
        # G-LEDGER-3: DISTINCT source_ref values -- a re-evaluated message
        # can append several rows for one source_ref.
        return {r.source_ref for r in self._read_rows()}

    def open_email_task_titles(self) -> list[str]:
        # G-LEDGER-4: parse ledger "writes" entries shaped
        # "task:<id>|<title>"; anything else is ignored.
        titles: list[str] = []
        for row in self._read_rows():
            for entry in row.writes:
                if not entry.startswith("task:") or "|" not in entry:
                    continue
                _, _, rest = entry.partition(":")
                _, _, title = rest.partition("|")
                titles.append(title)
        return titles

    def escalated_for(self, source_ref: str, digest: str) -> bool:
        # G-LEDGER-5: escalation-dedup lookup used by FR-003's escalate-once
        # rule -- true only against the LATEST row for the SAME digest.
        row = self.latest(source_ref)
        if row is None or row.content_digest != digest:
            return False
        return any(r.outcome == "escalated" for r in row.resolutions)
