# file: scripts/brain/client_state_gmail.py
"""Client State v1 — Gmail orchestrator (FR-001..FR-008). Composes observation_ledger,
gmail_source, resolve_email, extract_email, writeback_email, client_state_writes
behind one injectable Runner so dry-run and live share the exact same derivation
functions (G-PARITY-1): every write's inputs (extraction, HistoryEntry/apply_history's
new page text, plan_tasks' TaskPlan list) are computed ONCE per message regardless of
--dry-run, and only the final disposition (write vs. preview line) branches. The one
exception is contact auto-creation, documented at do_contact_write below."""
from __future__ import annotations

import argparse
import difflib
import json
import os
import sys
import tempfile
from dataclasses import dataclass, field
from datetime import date, datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

import extract_email
import gmail_source
import resolve_email
import single_flight
import writeback_email
from client_state_writes import create_task, ensure_contact, list_open_tasks, plan_tasks, write_interaction
from observation_ledger import Ledger, ObservationRow, Resolution, content_digest
from resolve_meeting import load_closed_sets  # imported unmodified, per architecture note


@dataclass
class Config:
    repo_root: Path
    vault: Path
    crm_dir: Path
    state_dir: Path
    days: int
    query: str | None
    dry_run: bool
    max_usd: float
    today: date
    now: datetime


@dataclass
class RunResult:
    exit_code: int
    filed: int = 0
    ignored: int = 0
    escalated: int = 0
    skipped_terminal: int = 0
    cost_usd: float = 0.0
    truncation: list[dict] = field(default_factory=list)
    previews: list[str] = field(default_factory=list)


@dataclass
class _RunState:
    """Mutable per-run accumulator — cost is the only thing shared across messages
    (the --max-usd cap is a whole-run budget, not per-message)."""
    cost: float = 0.0


@dataclass
class ContactPlan:
    action: str            # "known" | "create"
    contact_id: str | None
    name: str
    email: str


def plan_contact_write(msg, resolution: Resolution, contacts: list[dict]) -> ContactPlan:
    """PURE: decide whether the resolved counterparty already has a CRM contact row.
    Only From-header facts feed a create plan (G-CRM-1: header-only, never body
    content — msg.body_text is never read here)."""
    if resolution.contact_id:
        return ContactPlan("known", resolution.contact_id, msg.from_name, resolution.email)
    target = (resolution.email or "").strip().lower()
    for c in contacts:
        emails = [e for e in c.get("emails", []) if isinstance(e, str)]
        if any((e or "").strip().lower() == target for e in emails):
            return ContactPlan("known", str(c["id"]), msg.from_name, resolution.email)
    return ContactPlan("create", None, msg.from_name, resolution.email)


def preview_contact_write(plan: ContactPlan) -> str:
    if plan.action == "known":
        return f"CRM: contact already known ({plan.contact_id})"
    return f"CRM: would create contact name={plan.name!r} email={plan.email!r}"


def do_contact_write(runner, crm_dir: Path, plan: ContactPlan, contacts: list[dict]) -> str:
    """The one branch where dry-run and live cannot share a single call: creating a
    contact IS a write (ensure_contact shells out to upsert-contact.py), so dry-run
    stops at preview_contact_write and never calls this. Both functions are handed
    the SAME `plan` object, so the (name, email) preview_contact_write describes is
    exactly what a live run would pass to ensure_contact — no separate/duplicated
    argv-building exists to drift out of sync."""
    if plan.action == "known":
        return plan.contact_id
    return ensure_contact(runner, crm_dir, plan.name, plan.email, contacts)


def preview_interaction_write(contact_id: str, msg, extraction: dict) -> str:
    decisions = [d["text"] for d in extraction.get("decisions", [])]
    return (
        f"CRM row: contact={contact_id} type=email source_ref=gmail:{msg.id} "
        f"summary={extraction['summary']!r} decisions={decisions!r}"
    )


def _atomic_write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".csw-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


