def plan_history_write(vault: Path, resolution: Resolution, entry) -> tuple[Path, str, str]:
    """PURE (read-only): returns (page_path, old_text, new_text). Safe to call in
    dry-run — never writes; the SAME new_text is what do_history_write below
    persists in live mode (G-PARITY-1)."""
    page = writeback_email.page_path_for(vault, resolution.slug, resolution.kind)
    old_text = page.read_text(encoding="utf-8") if page.exists() else ""
    new_text = writeback_email.apply_history(old_text, entry)
    return page, old_text, new_text


def preview_history_write(page: Path, old_text: str, new_text: str) -> str:
    diff = "".join(
        difflib.unified_diff(
            old_text.splitlines(keepends=True), new_text.splitlines(keepends=True),
            fromfile=f"a/{page}", tofile=f"b/{page}",
        )
    )
    return f"page diff for {page}:\n{diff}" if diff else f"page diff for {page}: (no change)"


def do_history_write(page: Path, new_text: str) -> None:
    _atomic_write_text(page, new_text)


def preview_task(plan) -> str:
    if plan.dedup is not None:
        return f"task: {plan.title} (suppressed tier {plan.dedup['tier']} match: {plan.dedup['match']})"
    return f"task: {plan.title} (create)"


def do_create_task(runner, plan) -> str:
    return create_task(runner, plan)


def _write_receipt(state_dir: Path, receipt: dict) -> None:
    _atomic_write_text(state_dir / "run-receipt.json", json.dumps(receipt, indent=2) + "\n")


def _file_message(
    cfg: Config, runner, ledger: Ledger, msg, resolutions: list[Resolution],
    previews: list[str], state: _RunState, contacts: list[dict],
) -> tuple[int, int, int]:
    """Files every 'pending' resolution on `msg` — a resolution that resolved to an
    entity (contact-email or page-domain, resolve_email.EmailResolver) but has not
    yet been written (FR-001). A resolution that came back 'escalated' or 'ignored'
    is passed through unchanged: a message can be filed for one entity while another
    stays ambiguous (FR-001's per-resolution outcome). Returns (filed, escalated,
    ignored) counts for this message."""
    pending = [r for r in resolutions if r.outcome == "pending"]
    escalated_count = sum(1 for r in resolutions if r.outcome == "escalated")
    ignored_count = sum(1 for r in resolutions if r.outcome == "ignored")
    source_ref = f"gmail:{msg.id}"
    digest = content_digest(msg.subject, msg.body_text, msg.from_email)

    if not pending:
        # Every resolution is already escalated/ignored this run — still record the
        # row once so FR-003's "escalate exactly once per (source_ref, digest)" has
        # something to check against.
        row = ObservationRow(
            source_ref=source_ref, thread_id=msg.thread_id, content_digest=digest,
            observed_at=cfg.now.isoformat(), resolutions=resolutions,
        )
        if cfg.dry_run:
            previews.append(
                f"{source_ref}: no pending resolutions "
                f"(escalated={escalated_count} ignored={ignored_count})"
            )
        else:
            ledger.append(row)
        return 0, escalated_count, ignored_count

    slugs = sorted({r.slug for r in pending})
    prior = ledger.latest(source_ref)
    context = extract_email.build_context(
        extract_email.open_items_for(cfg.vault, slugs),
        ledger.open_email_task_titles(),
    )
    # Extraction runs in dry-run too (read-only LLM call); cached_or_extract's
    # ledger cache is what makes a repeat dry-run free (FR-001: at most one LLM
    # call per (source_ref, digest, sorted bound slugs)).
    extraction, called = extract_email.cached_or_extract(
        prior, msg, context, slugs, runner, max_usd=cfg.max_usd, spent_usd=state.cost,
    )
    if called:
        state.cost += float(extraction.get("cost_usd", 0.0))

    revision_of = prior.content_digest if (prior is not None and prior.content_digest != digest) else None

    writes: list[str] = []
    for resolution in pending:
        contact_plan = plan_contact_write(msg, resolution, contacts)
        if cfg.dry_run:
            previews.append(preview_contact_write(contact_plan))
            contact_id = contact_plan.contact_id or "<pending-contact>"
        else:
            contact_id = do_contact_write(runner, cfg.crm_dir, contact_plan, contacts)

        if cfg.dry_run:
            previews.append(preview_interaction_write(contact_id, msg, extraction))
        else:
            write_interaction(runner, cfg.crm_dir, contact_id, msg, extraction)
            writes.append(f"crm:{contact_id}")

        entry = writeback_email.HistoryEntry(
            date=msg.date_iso[:10], subject=msg.subject, source_ref=source_ref,
            summary=extraction["summary"],
            decisions=[d["text"] for d in extraction.get("decisions", [])],
            open_questions=[q["text"] for q in extraction.get("open_questions", [])],
            revision_of=revision_of,
        )
        page, old_text, new_text = plan_history_write(cfg.vault, resolution, entry)
        if cfg.dry_run:
            previews.append(preview_history_write(page, old_text, new_text))
        else:
            do_history_write(page, new_text)
            writes.append(str(page))

        resolution.outcome = "filed"

    open_tasks = list_open_tasks(runner)
    task_plans = plan_tasks(extraction, context, open_tasks, source_ref)
    suppressed: list[dict] = []
    for plan in task_plans:
        if cfg.dry_run:
            previews.append(preview_task(plan))
        if plan.dedup is not None:
            suppressed.append({"title": plan.title, "tier": plan.dedup["tier"], "match": plan.dedup["match"]})
            continue
        if not cfg.dry_run:
            task_id = do_create_task(runner, plan)
            writes.append(f"task:{task_id}|{plan.title}")

    if not cfg.dry_run:
        row = ObservationRow(
            source_ref=source_ref, thread_id=msg.thread_id, content_digest=digest,
            observed_at=cfg.now.isoformat(), resolutions=resolutions,
            extraction=extraction, writes=writes, revision_of=revision_of, suppressed=suppressed,
        )
        ledger.append(row)

    return len(pending), escalated_count, ignored_count


def run(cfg: Config, runner) -> RunResult:
    cfg.state_dir.mkdir(parents=True, exist_ok=True)
    claims_dir = cfg.state_dir / "claims"
    lease = single_flight.acquire(runner, claims_dir, "client-state-gmail", ttl_min=60)
    if lease is None:
        return RunResult(exit_code=2, previews=["lock held — another run is in progress"])

    result = RunResult(exit_code=0)
    ledger = Ledger(cfg.state_dir / "observations.jsonl")
    state = _RunState()

    try:
        if cfg.query:
            messages_raw = gmail_source.list_messages(runner, cfg.query)
            truncation: list[dict] = []
        else:
            messages_raw, truncation = gmail_source.sweep(runner, cfg.days, cfg.today)
        result.truncation = truncation

        contacts = resolve_email.load_contacts(cfg.crm_dir)
        closed = load_closed_sets(cfg.vault)
        resolver = resolve_email.EmailResolver(closed, contacts)

        for raw in messages_raw:
            lease.touch()
            message_id = raw.get("id") or raw.get("messageId")
            if not message_id:
                continue
            msg = gmail_source.read_message(runner, message_id)
            digest = content_digest(msg.subject, msg.body_text, msg.from_email)
            source_ref = f"gmail:{msg.id}"

            if ledger.is_terminal(source_ref, digest):
                result.skipped_terminal += 1
                continue

            resolutions = resolver.resolve_message(msg)
            if not resolutions:
                if cfg.dry_run:
                    result.previews.append(f"ignore {source_ref}: no-known-entity")
                else:
                    ledger.append(ObservationRow(
                        source_ref=source_ref, thread_id=msg.thread_id, content_digest=digest,
                        observed_at=cfg.now.isoformat(), resolutions=[], reason="no-known-entity",
                    ))
                result.ignored += 1
                continue

            filed, escalated, ignored = _file_message(
                cfg, runner, ledger, msg, resolutions, result.previews, state, contacts,
            )
            result.filed += filed
            result.escalated += escalated
            result.ignored += ignored

        receipt = {
            "last_success_at": cfg.now.isoformat(), "window_days": cfg.days,
            "message_count": len(messages_raw), "truncation": truncation, "cost_usd": state.cost,
        }
        if not cfg.dry_run:
            _write_receipt(cfg.state_dir, receipt)
        result.cost_usd = state.cost
        return result
    except extract_email.BudgetExceeded as exc:
        receipt = {
            "last_success_at": cfg.now.isoformat(), "window_days": cfg.days,
            "message_count": 0, "truncation": [], "cost_usd": state.cost, "error": "budget",
        }
        if not cfg.dry_run:
            _write_receipt(cfg.state_dir, receipt)
        result.exit_code = 12
        result.cost_usd = state.cost
        result.previews.append(f"budget exceeded: {exc}")
        return result
    finally:
        lease.release()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo-root", required=True)
    parser.add_argument("--vault", required=True)
    parser.add_argument("--crm-dir", required=True)
    parser.add_argument("--state-dir", required=True)
    parser.add_argument("--days", type=int, default=3)
    parser.add_argument("--query", default=None)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--max-usd", type=float, default=2.0)
    parser.add_argument("--today", default=None)
    args = parser.parse_args(argv)

    today = date.fromisoformat(args.today) if args.today else datetime.now(timezone.utc).date()
    cfg = Config(
        repo_root=Path(args.repo_root), vault=Path(args.vault), crm_dir=Path(args.crm_dir),
        state_dir=Path(args.state_dir), days=args.days, query=args.query, dry_run=args.dry_run,
        max_usd=args.max_usd, today=today, now=datetime.now(timezone.utc),
    )
    from runner import SubprocessRunner
    result = run(cfg, SubprocessRunner())
    for line in result.previews:
        print(line)
    print(
        f"filed={result.filed} escalated={result.escalated} ignored={result.ignored} "
        f"skipped_terminal={result.skipped_terminal} cost_usd={result.cost_usd:.4f}"
    )
    return result.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
