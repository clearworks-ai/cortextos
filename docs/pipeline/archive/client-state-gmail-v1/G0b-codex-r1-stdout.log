class TaskPlan:
    title: str
    owner: str
    source_ref: str
    dedup: dict | None   # None => create; else {"tier": 1|2, "match": str}


def plan_tasks(extraction: dict, context: list, open_tasks: list[dict], source_ref: str) -> list["TaskPlan"]:
    """FR-008: one TaskPlan per OURS (owner normalizes to "josh") commitment. A
    THEIRS commitment produces nothing — it's a digest line only, never a task.
    Tier 2 (extraction's own matches_open_item) is checked first and wins outright
    over tier 1 when both would match; tier 1 checks every context item, then
    every open task (both already filtered to Josh-owned by the --class human
    query in list_open_tasks, so the comparison owner is hardcoded "josh")."""
    plans: list[TaskPlan] = []
    for commitment in extraction.get("commitments", []) or []:
        owner = commitment.get("owner", "") or ""
        if normalize_owner(owner) != "josh":
            continue  # theirs: digest line only, never a task
        title = commitment.get("text", "") or ""
        match_idx = commitment.get("matches_open_item")
        if match_idx is not None:
            ctx_item = context[match_idx - 1]  # invocation-local ids are 1..N
            plans.append(TaskPlan(title, owner, source_ref, {"tier": 2, "match": ctx_item.text}))
            continue
        dedup = None
        for item in context:
            if tier1_duplicate(title, owner, item.text, item.owner):
                dedup = {"tier": 1, "match": item.text}
                break
        if dedup is None:
            for task in open_tasks or []:
                task_title = task.get("title", "") or ""
                if tier1_duplicate(title, owner, task_title, "josh"):
                    dedup = {"tier": 1, "match": task_title}
                    break
        plans.append(TaskPlan(title, owner, source_ref, dedup))
    return plans


def list_open_tasks(runner) -> list[dict]:
    """cortextos bus list-tasks --class human --limit 500 --format json (bus.ts has
    NO bare --json flag — --format json is the actual switch, verified at
    src/cli/bus.ts:786-902; see Task 14's deviation note). rc != 0 => []."""
    argv = ["cortextos", "bus", "list-tasks", "--class", "human", "--limit", "500", "--format", "json"]
    result = runner.run(argv)
    if result.returncode != 0:
        return []
    try:
        data = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def create_task(runner, plan: "TaskPlan") -> str:
    """cortextos bus create-task <title> --assignee human --type human --desc "source <ref>".
    Returns the id: bus.ts's create-task prints `console.log(taskId)` as the first
    stdout line."""
    argv = [
        "cortextos", "bus", "create-task", plan.title,
        "--assignee", "human",
        "--type", "human",
        "--desc", f"source {plan.source_ref}",
    ]
    result = runner.run(argv)
    stdout = (result.stdout or "").strip()
    return stdout.splitlines()[0] if stdout else ""
