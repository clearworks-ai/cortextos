"""Shared test double for runner.Runner, used across client-state tests
(single_flight, gmail_source, resolve_email, extract_email, client_state_writes,
client_state_gmail)."""
from __future__ import annotations

from dataclasses import dataclass, field
from subprocess import CompletedProcess


@dataclass
class FakeRunner:
    """Scripted responses keyed by argv PREFIX, checked in order: the first
    entry whose prefix matches argv[:len(prefix)] wins. Falls back to
    `default`, else an empty rc=0 CompletedProcess. Every call is recorded in
    `calls` for assertion."""

    responses: list[tuple[list[str], "CompletedProcess[str]"]] = field(default_factory=list)
    calls: list[dict] = field(default_factory=list)
    default: "CompletedProcess[str] | None" = None

    def run(
        self,
        argv: list[str],
        *,
        input: str | None = None,
        env: dict | None = None,
        timeout: int = 120,
    ) -> "CompletedProcess[str]":
        self.calls.append({"argv": list(argv), "input": input, "env": env, "timeout": timeout})
        for prefix, result in self.responses:
            if argv[: len(prefix)] == prefix:
                return result
        if self.default is not None:
            return self.default
        return CompletedProcess(argv, returncode=0, stdout="", stderr="")
