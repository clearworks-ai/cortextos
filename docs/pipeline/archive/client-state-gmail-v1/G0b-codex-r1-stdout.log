    "pytest_passed": int(pp),
    "pytest_failed": int(pf),
    "pytest_failing": sorted(x for x in pfailing.split() if x),
}
with open(out, "w") as fh:
    json.dump(doc, fh, indent=2, sort_keys=True)
    fh.write("\n")
print(json.dumps(doc, sort_keys=True))
PY
}

