def acquire(runner: Runner, claims_dir: Path, name: str, ttl_min: int = 60) -> Lease | None:
    result = runner.run(
        [
            "cortextos",
            "bus",
            "meeting-brief-claim",
            name,
            "--claims-dir",
            str(claims_dir),
            "--ttl-min",
            str(ttl_min),
        ]
    )
    if result.returncode != 0:
        return None
    return Lease(claims_dir=Path(claims_dir), name=name, runner=runner)
