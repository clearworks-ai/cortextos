#!/bin/bash
# Runs EVERY GUARD_REGISTRY row (39: 37 scripts/brain/*.py + 2 src/bus/task.ts)
# through control-PASS -> sed-mutate -> diff-prove-applied -> mutated-FAIL ->
# revert, dispatching on module_path's extension. Writes g4/py-guards.json
# (.py rows) and g4/bus-guards.json (.ts rows). BSD/macOS `sed -i ''`.
set -euo pipefail

REPO_ROOT="${CLIENT_STATE_REPO_ROOT:-/Users/joshweiss/code/cortextos-worktrees/client-state-gmail-v1}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
G4_DIR="${CLIENT_STATE_G4_DIR:-$SELF_DIR/g4}"
mkdir -p "$G4_DIR"

cd "$REPO_ROOT"

FAILED=0

run_py_node() {
  python3 -m pytest "$1" -q -p no:cacheprovider
}

run_ts_node() {
  # $1 = "path::test title" — split on the FIRST "::" only (a vitest test
  # title may itself contain "::").
  local node="$1" file title
  file="${node%%::*}"
  title="${node#*::}"
  npx vitest run "$file" -t "$title"
}

registry_rows() {
  # Emits ALL 39 rows, tab-separated: guard_id, module_path, test_node_id, sed_expr.
  python3 - <<'PY'
import sys
sys.path.insert(0, "scripts/brain/tests")
import test_client_state_guards as m
for row in m.GUARD_REGISTRY:
    guard_id, module_path, description, test_node_id, sed_expr = row
    print("\t".join([guard_id, module_path, test_node_id, sed_expr]))
PY
}

run_one_row() {
  # $1=guard_id $2=module_path $3=test_node_id $4=sed_expr $5=out_json $6=is_ts(0/1)
  local guard_id="$1" module_path="$2" test_node_id="$3" sed_expr="$4" out="$5" is_ts="$6"
  echo "== $guard_id =="
  local control_green=false mutation_applied=false mutated_red=false
  if [ "$is_ts" -eq 1 ]; then
    if run_ts_node "$test_node_id"; then control_green=true; fi
  else
    if run_py_node "$test_node_id"; then control_green=true; fi
  fi
  local before after
  before="$(cat "$module_path")"
  sed -E -i '' -e "$sed_expr" "$module_path"
  after="$(cat "$module_path")"
  if [ "$before" != "$after" ]; then
    mutation_applied=true
    if [ "$is_ts" -eq 1 ]; then
      if ! run_ts_node "$test_node_id"; then mutated_red=true; fi
    else
      if ! run_py_node "$test_node_id"; then mutated_red=true; fi
    fi
  fi
  git checkout -- "$module_path"
  if [ "$is_ts" -eq 1 ]; then
    printf '"control_green": %s, "mutation_applied": %s, "mutated_red": %s, "diff_applied": %s' \
      "$control_green" "$mutation_applied" "$mutated_red" "$mutation_applied" > "$SELF_DIR/.row.$$"
  else
    printf '"control_green": %s, "mutation_applied": %s, "mutated_red": %s' \
      "$control_green" "$mutation_applied" "$mutated_red" > "$SELF_DIR/.row.$$"
  fi
  if [ "$control_green" != "true" ] || [ "$mutation_applied" != "true" ] || [ "$mutated_red" != "true" ]; then
    FAILED=1
  fi
}

py_out="$G4_DIR/py-guards.json"
ts_out="$G4_DIR/bus-guards.json"
: > "$py_out"; echo "{" >> "$py_out"
: > "$ts_out"; echo "{" >> "$ts_out"
py_first=1
ts_first=1

while IFS=$'\t' read -r guard_id module_path test_node_id sed_expr; do
  [ -z "$guard_id" ] && continue
  case "$module_path" in
    *.ts)
      run_one_row "$guard_id" "$module_path" "$test_node_id" "$sed_expr" "$ts_out" 1
      row_body="$(cat "$SELF_DIR/.row.$$")"; rm -f "$SELF_DIR/.row.$$"
      if [ "$ts_first" -eq 0 ]; then printf ',\n' >> "$ts_out"; fi
      ts_first=0
      printf '  "%s": {%s}' "$guard_id" "$row_body" >> "$ts_out"
      ;;
    *)
      run_one_row "$guard_id" "$module_path" "$test_node_id" "$sed_expr" "$py_out" 0
      row_body="$(cat "$SELF_DIR/.row.$$")"; rm -f "$SELF_DIR/.row.$$"
      if [ "$py_first" -eq 0 ]; then printf ',\n' >> "$py_out"; fi
      py_first=0
      printf '  "%s": {%s}' "$guard_id" "$row_body" >> "$py_out"
      ;;
  esac
done < <(registry_rows)

printf '\n}\n' >> "$py_out"
printf '\n}\n' >> "$ts_out"

exit "$FAILED"
