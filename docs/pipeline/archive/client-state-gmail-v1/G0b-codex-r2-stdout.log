    preview_argv = csp.plan_upsert_contact_argv(crm_dir, msg.from_name, msg.from_email)

    runner = _FakeRunner()
    live_argv = csp.plan_upsert_contact_argv(crm_dir, msg.from_name, msg.from_email)
    runner.run(live_argv)

    assert runner.calls[0] == preview_argv
