def test_escalation_text_parity_via_real_fake_runner_execution():
    """G-PARITY-1 (was a documented gap before C6): plan_escalation's text
    IS the send-telegram argv's 5th element on the live path — no skip."""
    msg = _fixture_message()
    ambiguous = _fixture_resolution(
