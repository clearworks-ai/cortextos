    runner = _FakeRunner()
    live_argv = csp.plan_add_interaction_argv(crm_dir, contact_id, msg, extraction)
    runner.run(live_argv)  # the live consumer: runner.run(plan_add_interaction_argv(...))

    assert runner.calls[0] == preview_argv
    assert f"gmail:{msg.id}" in preview_argv
    assert extraction["summary"] in preview_argv


def test_upsert_contact_argv_parity_via_real_fake_runner_execution():
    msg = _fixture_message()
