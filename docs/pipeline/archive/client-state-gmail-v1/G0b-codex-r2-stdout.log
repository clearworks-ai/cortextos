# file: scripts/brain/tests/test_client_state_parity.py
"""Parity between the --dry-run preview and the live write/send, per
projection, against the SHARED contract C6 module scripts/brain/
client_state_projections.py (Task 15/S-06): six PURE functions (no I/O, no
subprocess) that are the ONLY source for both the preview text AND the argv/
text the live path executes. NO SKIPS (G0B-24): every projection, including
escalation and digest, is asserted end-to-end against a REAL executed
consumer (a FakeRunner.run() call, or writeback_email's real
render_history_entry/apply_history), never two calls to the planning
function alone.

If scripts/brain/client_state_projections.py is not yet present (C6 is
authored by the S-06 writer in parallel with this section), these tests
ERROR on collection with a clear ModuleNotFoundError naming the missing
module and the contract that defines it — this file never stubs C6's
functions itself, since doing so would hide a real integration gap instead
of surfacing it (the wave-2 coordinator's instruction to "stub and say so"
governs the WRITER'S OWN interim verification run, not this delivered test).
"""
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[3]
BRAIN_DIR = REPO_ROOT / "scripts" / "brain"
sys.path.insert(0, str(BRAIN_DIR))

import client_state_projections as csp  # noqa: E402
import client_state_writes  # noqa: E402
import gmail_source  # noqa: E402
import writeback_email  # noqa: E402
from observation_ledger import ObservationRow, Resolution  # noqa: E402


class _FakeRunner:
    """The live-consumer stand-in C11 calls for: 'run do_* against a tmp
    copy / FakeRunner and compare the argv/text it used'. Every write/send
    branch in the real orchestrator (C7) is `runner.run(plan_<x>(...))` —
    this class just records what it was given."""

    def __init__(self) -> None:
        self.calls: list[list[str]] = []

    def run(self, argv, *, input=None, env=None, timeout=120):
        self.calls.append(list(argv))
        return subprocess.CompletedProcess(args=argv, returncode=0, stdout="{}", stderr="")


def _fixture_message() -> gmail_source.Message:
    return gmail_source.Message(
        id="19a1b2c3d4e5f", thread_id="thread-1",
        from_name="Lori Bodenhamer", from_email="lori@abundowealth.com",
        to=["josh@clearworks.ai"], cc=[], subject="Re: Q4 budget + SOW",
        date_iso="2026-09-14T11:58:00Z",
        body_text="Confirmed the Q4 budget. Can you send the revised SOW?",
    )


def _fixture_resolution(**overrides) -> Resolution:
    base = dict(
        slug="abundo-wealth", kind="client", method="contact-email",
        outcome="filed", reason="", contact_id="lori-bodenhamer",
        email="lori@abundowealth.com",
    )
    base.update(overrides)
    return Resolution(**base)


def _fixture_extraction() -> dict:
    return {
        "summary": "Lori confirmed the Q4 budget and asked for the updated SOW.",
        "decisions": [{"text": "Q4 budget approved at $42,000"}],
        "open_questions": [{"text": "Does the SOW need a new signature page?"}],
        "commitments": [{"text": "Send the revised SOW", "owner_name": "Josh"}],
        "cost_usd": 0.0421,
        "model_receipt": "sonnet",
    }


def _fixture_row(resolution: Resolution) -> ObservationRow:
    return ObservationRow(
        source_ref="gmail:19a1b2c3d4e5f", thread_id="thread-1",
        content_digest="deadbeefcafefeed", observed_at="2026-09-14T12:00:00Z",
        resolutions=[resolution],
    )


def test_history_entry_parity_byte_identical_via_real_consumer():
    """plan_history_entry's HistoryEntry is the ONE value that BOTH the
    dry-run diff-preview and the live writer consume. Proves it by running
    the REAL consumer (writeback_email.apply_history) against the SAME
    entry the "preview" call produced, and asserting the rendered lines
    appear verbatim in what apply_history actually persists."""
    resolution = _fixture_resolution()
    row = _fixture_row(resolution)
    msg = _fixture_message()
    extraction = _fixture_extraction()

    entry_preview = csp.plan_history_entry(row, resolution, extraction, msg)
    entry_again = csp.plan_history_entry(row, resolution, extraction, msg)
    assert entry_preview == entry_again  # pure/deterministic

    rendered_preview = writeback_email.render_history_entry(entry_preview)
    live_page_text = writeback_email.apply_history("", entry_preview)  # the REAL live consumer
    for line in rendered_preview:
        assert line in live_page_text
    assert "gmail:19a1b2c3d4e5f" in live_page_text


def test_add_interaction_argv_parity_via_real_fake_runner_execution():
    """The preview argv and the argv a live runner.run() call actually
    receives are asserted equal by EXECUTING the FakeRunner (C11's 'run do_*
    against ... FakeRunner and compare the argv it used'), not by calling
    the planning function twice and stopping there."""
    msg = _fixture_message()
    extraction = _fixture_extraction()
    contact_id = "lori-bodenhamer"
    crm_dir = Path("/tmp/does-not-matter-crm")

