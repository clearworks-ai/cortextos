  3817	class FakeRunner:
  3818	    """Test double for runner.Runner (C1 -- the ONE fake every task uses).
  3819	
  3820	    `responses` is EITHER a list of `(argv_prefix, CompletedProcess)` pairs OR a
  3821	    dict `{argv_prefix: CompletedProcess}`; a dict is normalized to a list in
  3822	    insertion order, so the semantics below are identical for both.
  3823	
  3824	    MATCHING (exact contract, G0A2-1/G0B2-1):
  3825	      * `run(argv)` scans the list FRONT TO BACK and takes the FIRST entry whose
  3826	        prefix equals `argv[:len(prefix)]` -- first match in insertion order.
  3827	      * That entry is CONSUMED (removed) **only if another entry with an
  3828	        IDENTICAL prefix appears LATER in the list.** Otherwise it stays.
  3829	
  3830	    The two consequences the consumers rely on:
  3831	      1. A prefix recorded ONCE is STICKY -- it answers every call shaped like
  3832	         it, however many times the code under test issues one (Task 8's
  3833	         day-sweep issues 1+days triage queries; Task 15 writes one CRM
  3834	         interaction per contact; Task 19 enumerates two task classes).
  3835	      2. A prefix recorded N times plays those N responses IN ORDER, and the
  3836	         LAST one is sticky (Task 2's `stale-cleared` refusal followed by the
  3837	         winning claim; Task 11's widen-and-rerun).
  3838	
  3839	    `.calls` collects each call's argv as a bare `list[str]` (no wrapper dict).
  3840	    An unmatched argv returns rc 127 rather than raising, so a missing fixture
  3841	    fails loudly at an assert instead of deep inside a stack trace."""
  3842	
  3843	    def __init__(
  3844	        self,
  3845	        responses: (
  3846	            "list[tuple[Sequence[str], CompletedProcess]] "
  3847	            "| dict[tuple[str, ...], CompletedProcess] | None"
  3848	        ) = None,
  3849	    ) -> None:
  3850	        if responses is None:
  3851	            pairs: list[tuple[list[str], CompletedProcess]] = []
  3852	        elif isinstance(responses, dict):
  3853	            pairs = [(list(prefix), result) for prefix, result in responses.items()]
  3854	        else:
  3855	            pairs = [(list(prefix), result) for prefix, result in responses]
  3856	        self.responses: list[tuple[list[str], CompletedProcess]] = pairs
  3857	        self.calls: list[list[str]] = []
  3858	
  3859	    def record(self, prefix: Sequence[str], rc: int = 0, stdout: str = "", stderr: str = "") -> None:
  3860	        prefix_list = list(prefix)
  3861	        self.responses.append((prefix_list, CompletedProcess(prefix_list, rc, stdout, stderr)))
  3862	
  3863	    def run(
  3864	        self,
  3865	        argv: list[str],
  3866	        *,
  3867	        input: str | None = None,
  3868	        env: dict | None = None,
  3869	        timeout: int = 120,
  3870	    ) -> CompletedProcess:
  3871	        self.calls.append(list(argv))
  3872	        for i, (prefix, result) in enumerate(self.responses):
  3873	            if list(argv[: len(prefix)]) == prefix:
  3874	                # Consume ONLY when a later entry repeats this exact prefix, so a
  3875	                # multi-response sequence plays in order and its last entry is
  3876	                # sticky; a prefix recorded once answers every matching call.
  3877	                if any(later == prefix for later, _ in self.responses[i + 1 :]):
  3878	                    del self.responses[i]
  3879	                return result
  3880	        return CompletedProcess(argv, 127, "", f"FakeRunner: no response for {argv!r}")
