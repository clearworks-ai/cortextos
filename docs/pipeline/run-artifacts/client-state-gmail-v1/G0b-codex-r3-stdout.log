@dataclass
class ContextItem:
    id: int
    text: str
    owner: str
    source: str


class ExtractionError(Exception):
    """claude rc != 0, or the model's JSON failed to parse or validate."""

    def __init__(self, reason: str) -> None:
        super().__init__(reason)
        self.reason = reason


class BudgetExceeded(Exception):
