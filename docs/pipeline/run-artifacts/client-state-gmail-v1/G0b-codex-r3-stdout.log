  9851	                # G0B2-13: our lock file is gone, so single-flight is no longer
  9852	                # guaranteed. STOP before any further effect rather than racing
  9853	                # the run that reclaimed it (and never release its lease).
  9854	                raise single_flight.LeaseLost(
  9855	                    "client-state-gmail lease disappeared mid-run — stopping before further writes"
  9856	                )
