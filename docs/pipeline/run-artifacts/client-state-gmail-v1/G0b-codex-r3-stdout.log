  9841	        messages_raw, truncation = gmail_source.sweep(runner, cfg.days, cfg.today, extra_query=cfg.query)  # G-QUERY-1
  9842	        result.truncation = truncation
  9843	
  9844	        contacts = resolve_email.load_contacts(cfg.crm_dir)
  9845	        closed = load_closed_sets(cfg.vault)
  9846	        resolver = resolve_email.EmailResolver(closed, contacts)
  9847	
  9848	        for raw in messages_raw:
  9849	            lease.touch()
