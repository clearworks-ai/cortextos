 14338	def confirmed_crm_keys(ledger) -> set[tuple[str, str]]:
 14339	    """G0B2-12 / decision (j): the keys the NEW path is PROVEN to have covered
 14340	    -- (source_ref, contact_id) for every REAL `crm:<contact_id>` write token,
 14341	    read across the ledger's FULL history (a message can be filed partially
 14342	    across several runs).
 14343	
 14344	    Deliberately NOT `Ledger.distinct_refs()`: that set contains every
 14345	    OBSERVED ref, including the ones the new path ignored, escalated, or only
 14346	    filed for SOME of a multiparty message's contacts. Those are exactly the
 14347	    coverage losses FR-006 exists to enumerate, and treating them as covered
 14348	    is how a rollout silently drops mail. Simulated (dry-run) rows write
 14349	    nothing, so their `planned_writes` never count as coverage."""
 14350	    keys: set[tuple[str, str]] = set()
 14351	    for row in ledger.all_rows():  # full history, not just the latest row per ref
 14352	        if getattr(row, "simulated", False):
 14353	            continue
 14354	        for write in row.writes:
 14355	            if write.startswith("crm:"):
 14356	                keys.add((row.source_ref, write.split(":", 1)[1]))
 14357	    return keys
 14358	
