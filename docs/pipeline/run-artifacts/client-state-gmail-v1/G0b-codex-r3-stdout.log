  9828	        # last-lock-refusal.json. record_failure is for the gws/extraction/
  9829	        # writer/budget/catch-all paths, which the goal still wants on the
  9830	        # receipt; a fail-closed halt must not falsify the success receipt.
  9831	        record_lock_refusal(cfg.state_dir, holder_pid=os.getpid(), detail=str(claims_dir))  # G-LOCKREF-1
  9832	        return RunResult(exit_code=2, previews=["lock held — another run is in progress"])
  9833	
  9834	    result = RunResult(exit_code=0)
  9835	    ledger = Ledger(cfg.state_dir / "observations.jsonl")
  9836	    state = _RunState()
  9837	    messages_raw: list[dict] = []
  9838	    truncation: list[dict] = []
