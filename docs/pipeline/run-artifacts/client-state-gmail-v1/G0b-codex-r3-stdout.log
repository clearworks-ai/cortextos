 14360	def old_path_rows(rows: list[dict], since: str, confirmed: set[tuple[str, str]]) -> list[dict]:
 14361	    """Every in-window old-path interaction whose (source_ref, contact_id) the
 14362	    new path did NOT confirm a CRM write for."""
 14363	    out = []
 14364	    for row in rows:
 14365	        source_ref = row.get("source_ref") or ""
 14366	        ts = row.get("ts") or ""
 14367	        if not source_ref.startswith("gmail:"):
 14368	            continue
 14369	        if ts < since:
 14370	            continue
 14371	        if (source_ref, str(row.get("contact_id") or "")) in confirmed:
 14372	            continue
 14373	        out.append(row)
 14374	    return out
