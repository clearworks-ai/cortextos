 15059	backup_target() {
 15060	  # $1 = module_path (relative to REPO_ROOT). Copies it to a fresh backup file,
 15061	  # registers it for EXIT-trap restore, and publishes the path in the GLOBAL
 15062	  # LAST_BACKUP.
 15063	  #
 15064	  # G0B2-8: this MUST be called in the parent shell. It used to be invoked as
 15065	  # `backup="$(backup_target ...)"`, whose command substitution runs in a
 15066	  # SUBSHELL -- the RESTORE_TARGETS/RESTORE_BACKUPS appends happened there and
 15067	  # vanished, so the EXIT trap had zero registered targets and an interrupted
 15068	  # run left the tree mutated while deleting the only backups.
 15069	  local module_path="$1"
 15070	  local backup="$BACKUP_DIR/$(echo "$module_path" | tr '/' '_').bak"
 15071	  cp "$module_path" "$backup"
 15072	  RESTORE_TARGETS+=("$module_path")
 15073	  RESTORE_BACKUPS+=("$backup")
 15074	  LAST_BACKUP="$backup"
 15075	}
