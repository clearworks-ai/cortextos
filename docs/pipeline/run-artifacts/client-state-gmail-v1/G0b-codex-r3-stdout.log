 14377	def classify(row: dict, from_tokens: list[str], subject_tokens: list[str],
 14378	             contacts_by_id: dict, resolver) -> str:
 14379	    summary = row.get("summary") or ""
 14380	    if summary.startswith("SENT:"):
 14381	        return "sent-mail"
 14382	    email = primary_email(contacts_by_id.get(row.get("contact_id")))
 14383	    subject = parse_subject(summary).lower()
 14384	    if email and any(tok in email for tok in from_tokens):
 14385	        return "automated-sender"
 14386	    if subject and any(tok in subject for tok in subject_tokens):
 14387	        return "automated-sender"
 14388	    if resolver is not None:
 14389	        if not email:
 14390	            return "unknown-entity"
