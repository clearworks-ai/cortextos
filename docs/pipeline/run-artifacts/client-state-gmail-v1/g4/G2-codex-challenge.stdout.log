   143	def _address_from_value(value: Any) -> tuple[str, str]:
   144	    """(name, email) for ONE address item: a "Name <addr>" string, a bare address
   145	    string, or a dict {"name", "email"} (also accepts key "address" in place of
   146	    "email") — the S-03/S-04 writer's +read fixtures use the dict shape for "from"."""
