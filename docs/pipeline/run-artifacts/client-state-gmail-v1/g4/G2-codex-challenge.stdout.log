   210	
   211	def plan_tasks(extraction: dict, context: list, open_tasks: list[dict], source_ref: str) -> list["TaskPlan"]:
   212	    """FR-008: one TaskPlan per OURS (owner_name normalizes to "josh") commitment.
   213	    G0A-2/G0B-7 fix: reads `commitment["owner_name"]` -- the schema-binding field
   214	    name (email_extraction.schema.json commitments[].owner_name,
   215	    additionalProperties:false) -- never "owner". A THEIRS commitment produces
   216	    nothing. Tier 2 (extraction's own matches_open_item) is checked first and
   217	    wins outright over tier 1. Tier 1 checks every context item, then every
   218	    currently-open task (`open_tasks`, from list_open_tasks -- G0B-8: owner
   219	    comparison uses that task's OWN `assigned_to`, never a hardcoded "josh")."""
   220	    plans: list[TaskPlan] = []
   221	    for commitment in extraction.get("commitments", []) or []:
   222	        owner = commitment.get("owner_name", "") or ""
   223	        if normalize_owner(owner) != "josh":
   224	            continue  # theirs: digest line only, never a task
   225	        title = commitment.get("text", "") or ""
   226	        match_idx = commitment.get("matches_open_item")
   227	        if match_idx is not None:
   228	            ctx_item = context[match_idx - 1]  # invocation-local ids are 1..N
   229	            plans.append(TaskPlan(title, owner, source_ref, {"tier": 2, "match": ctx_item.text}))
   230	            continue
   231	        dedup = None
   232	        for item in context:
   233	            if tier1_duplicate(title, owner, item.text, item.owner):
   234	                dedup = {"tier": 1, "match": item.text}
   235	                break
   236	        if dedup is None:
   237	            for task in open_tasks or []:
   238	                task_owner = task.get("assigned_to", "") or ""
   239	                task_title = task.get("title", "") or ""
   240	                if tier1_duplicate(title, owner, task_title, task_owner):
   241	                    dedup = {"tier": 1, "match": task_title}
   242	                    break
   243	        plans.append(TaskPlan(title, owner, source_ref, dedup))
   244	    return plans
