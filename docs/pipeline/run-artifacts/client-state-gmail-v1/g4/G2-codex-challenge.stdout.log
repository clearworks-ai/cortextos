   127	        data = json.loads(path.read_text(encoding="utf-8"))
   128	    except (OSError, ValueError):
   129	        return None
   130	    if not isinstance(data, dict) or "epoch" not in data or "invariants" not in data:
   131	        return None
   132	    return data
