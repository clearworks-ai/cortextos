    87	def apply_history(page_text: str, e: HistoryEntry) -> str:
    88	    """Append the rendered entry at the end of the '## History...' section's
    89	    CONTENT (before any trailing blank spacer lines that separate it from the
    90	    next heading), matched by heading PREFIX so this lands in the existing
    91	    '## History (dated, newest first)' section the meeting pipeline already
    92	    writes on these SAME pages (page_path_for below resolves to the identical
    93	    clients/orgs/projects file) instead of opening a second, competing History
    94	    section. Creates the section at the end of the page when absent. NEVER
    95	    removes or rewrites a line: every original line of page_text — blank
    96	    lines included — still appears, in the same order, in the output
    97	    (G-HIST-2)."""
    98	    new_lines = render_history_entry(e)
    99	    new_block = [f"{ln}\n" for ln in new_lines]
   100	    preamble, sections = _split_sections(page_text)
   101	    rebuilt: list[str] = []
   102	    found = False
   103	    for heading, body in sections:
   104	        if not found and heading.startswith("History"):
   105	            found = True
   106	            body_lines = body.splitlines(keepends=True)
   107	            trail: list[str] = []
   108	            while body_lines and body_lines[-1].strip() == "":
   109	                trail.insert(0, body_lines.pop())
   110	            if body_lines and not body_lines[-1].endswith("\n"):
   111	                body_lines[-1] = body_lines[-1] + "\n"
   112	            body = "".join(body_lines) + "".join(new_block) + "".join(trail)
   113	        else:
   114	            body = body if body.endswith("\n") or body == "" else body + "\n"
   115	        rebuilt.append(body)
   116	    pre = preamble if preamble.endswith("\n") or preamble == "" else preamble + "\n"
   117	    if found:
   118	        return pre + "".join(rebuilt)
   119	    tail = "".join(rebuilt)
   120	    if tail and not tail.endswith("\n\n"):
   121	        tail = tail if tail.endswith("\n") else tail + "\n"
   122	        tail += "\n"
   123	    new_section = "## History (dated, newest first)\n\n" + "".join(new_block)
   124	    return pre + tail + new_section
   125	
