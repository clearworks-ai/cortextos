   128	
   129	@contextlib.contextmanager
   130	def _page_lock(page: Path, heartbeat=None, *, clock: Callable[[], float] = time.monotonic):
   131	    """FR-008 advisory lock over ONE client page's read-modify-write, acquired
   132	    with a TIMED, NON-BLOCKING flock loop.
   133	
   134	    The lock FILE is the same sibling `<page>.lock` meeting_writeback.py uses,
   135	    so the two pipelines still serialise against each other (G-HIST-2). What
   136	    changed is the WAIT: `flock(LOCK_EX)` blocks inside the kernel, where
   137	    nothing can heartbeat, so a page held by another process for longer than the
   138	    60-minute claim TTL let this run's own lease go stale -- the next cron then
   139	    cleared the "stale" claim and started a SECOND concurrent run while this one
   140	    was still alive (G2B-4). Every poll ticks the heartbeat, which both touches
   141	    the lease and raises LeaseLost the moment we stop owning it. Past the bound
   142	    we give up LOUDLY (record_failure + exit 3), never on a silent stale claim.
   143	    """
   144	    lock_path = _page_lock_path(page)
   145	    lock_path.parent.mkdir(parents=True, exist_ok=True)
   146	    handle = open(lock_path, "w", encoding="utf-8")
   147	    deadline = clock() + PAGE_LOCK_TIMEOUT_S
   148	    try:
   149	        while True:
   150	            try:
   151	                # LOCK_NB, never a bare LOCK_EX: a blocking flock waits inside
   152	                # the kernel, where the tick below can never run.
   153	                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
   154	                break
   155	            except OSError:
   156	                if heartbeat is not None:
   157	                    heartbeat.tick()  # G-LOCK-10
   158	                if clock() >= deadline:
   159	                    raise PageLockTimeout(
   160	                        f"page lock held by another process for more than "
   161	                        f"{PAGE_LOCK_TIMEOUT_S:.0f}s: {lock_path}"
   162	                    ) from None
   163	                _page_lock_sleep(PAGE_LOCK_POLL_S)
   164	        try:
   165	            yield
   166	        finally:
   167	            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
   168	    finally:
   169	        handle.close()
