   233	def _required_effects(resolution: Resolution, page_key: str | None, task_keys: list[str]) -> list[str]:
   234	    """Every effect key that must LAND before this resolution can be `filed`
   235	    (G0B3-1). CRM only when a contact id resolved; the History page for its
   236	    bound slug; and every task this message creates (tasks are per-message, so
   237	    a resolution is not complete while a commitment task is still missing)."""
   238	    required: list[str] = []
   239	    if resolution.contact_id:
   240	        required.append(f"crm:{resolution.contact_id}")
   241	    if page_key:
   242	        required.append(page_key)
   243	    required.extend(task_keys)
   244	    return required
