   107	
   108	class PageLockTimeout(Exception):
   109	    """Another process held a client page's advisory lock past PAGE_LOCK_TIMEOUT_S."""
   110	
   111	
   112	def _page_lock_sleep(seconds: float) -> None:
   113	    """Indirection so a test can drive the wait loop on a fake clock."""
