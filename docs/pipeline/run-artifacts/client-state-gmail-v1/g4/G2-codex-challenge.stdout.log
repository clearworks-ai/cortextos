   127	def page_path_for(vault: Path, slug: str, kind: str) -> Path:
   128	    """org_brain_root(vault)/<clients|orgs|projects>/<slug>.md — the same path
   129	    convention writeback_render's meeting pipeline uses, so email and meeting
   130	    History entries land on one page per entity."""
   131	    directory = _KIND_DIRS.get(kind, kind if kind.endswith("s") else f"{kind}s")
   132	    return org_brain_root(vault) / directory / f"{slug}.md"

