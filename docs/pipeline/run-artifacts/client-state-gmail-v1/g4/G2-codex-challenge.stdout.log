   146	class HeartbeatRunner:
   147	    """Wraps a Runner so EVERY call boundary is a heartbeat opportunity — the
   148	    sweep's per-day queries, each `gws +read`, the `claude` call, and every CRM
   149	    or bus write all go through `Runner.run`, so this is the one place that
   150	    covers them all without threading a callback through six modules."""
   151	
   152	    def __init__(self, inner, heartbeat: "Heartbeat") -> None:
   153	        self.inner = inner
   154	        self.heartbeat = heartbeat
   155	
   156	    @property
   157	    def calls(self):
   158	        return getattr(self.inner, "calls", [])
   159	
   160	    def run(self, argv, *, input=None, env=None, timeout: int = 120):
   161	        self.heartbeat.tick()       # G-LOCK-8: before the call, so a long one is bracketed
   162	        result = self.inner.run(argv, input=input, env=env, timeout=timeout)
   163	        self.heartbeat.tick()       # and after, so the NEXT call starts from a fresh touch
   164	        return result
