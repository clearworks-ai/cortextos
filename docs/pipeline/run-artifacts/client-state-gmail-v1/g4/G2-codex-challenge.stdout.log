   144	def merge_unique(existing: list, additions: list) -> list:
   145	    seen = set()
   146	    merged = []
   147	    for item in [*existing, *additions]:
   148	        key = json.dumps(item, sort_keys=True) if isinstance(item, (dict, list)) else item
