   193	
   194	def _resolution_signature(resolutions: list[Resolution]) -> frozenset:
   195	    return frozenset((r.slug, r.contact_id, r.email, r.outcome, r.reason) for r in resolutions)
   196	
   197	
   198	def _merge_resolutions(prior_same_digest: ObservationRow | None, fresh: list[Resolution]) -> list[Resolution]:
   199	    """G0B-3 / G0B3-1: carry forward every resolution ALREADY filed on the prior
   200	    row for this exact digest -- never re-process it. For one NOT yet filed,
   201	    carry its LANDED EFFECT KEYS (and any contact_id it earned) onto the fresh
   202	    resolution, so the retry completes only what is still missing and never
   203	    replays a landed effect. Everything else is re-evaluated afresh: an
   204	    escalated/ignored resolution is re-checked every run (a cheap closed-sets
   205	    re-check, no LLM call), and a genuinely new counterparty is 'pending'."""
   206	    if prior_same_digest is None:
   207	        return fresh
   208	    prior_by_key = {_resolution_key(r): r for r in prior_same_digest.resolutions}
   209	    merged: list[Resolution] = []
   210	    seen: set[tuple[str, str]] = set()
   211	    for r in fresh:
   212	        key = _resolution_key(r)
   213	        seen.add(key)
   214	        old = prior_by_key.get(key)
   215	        if old is not None and old.outcome == "filed":  # G-MERGE-1
   216	            merged.append(old)
   217	            continue
   218	        if old is not None:
   219	            r.effects = list(old.effects)  # G-MERGE-2: landed effects survive the retry
   220	            if old.contact_id and not r.contact_id:
   221	                r.contact_id = old.contact_id
   222	        merged.append(r)
   223	    for key, old in prior_by_key.items():
   224	        # G-MERGE-3: a counterparty the resolver no longer produces (a contact
   225	        # removed from the CRM, a page whose domains line changed) but which we
   226	        # ALREADY filed must stay on the row -- dropping it would make the row
   227	        # look complete-but-smaller and lose the record of a real write.
   228	        if key not in seen and old.outcome == "filed":  # G-MERGE-3
   229	            merged.append(old)
   230	    return merged
