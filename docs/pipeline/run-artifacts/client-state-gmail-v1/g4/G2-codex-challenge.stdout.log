   247	def _atomic_write_text(path: Path, text: str) -> None:
   248	    path.parent.mkdir(parents=True, exist_ok=True)
   249	    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".csw-", suffix=".tmp")
   250	    try:
   251	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   252	            fh.write(text)
   253	        os.replace(tmp, path)
   254	    except BaseException:
   255	        try:
   256	            os.unlink(tmp)
   257	        except OSError:
   258	            pass
   259	        raise
