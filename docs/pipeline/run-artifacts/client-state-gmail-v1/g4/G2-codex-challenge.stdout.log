   193	def tier1_duplicate(a_text: str, a_owner: str, b_text: str, b_owner: str) -> bool:
   194	    """FR-008 tier 1: normalized owner match AND difflib.SequenceMatcher ratio
   195	    STRICTLY > 0.75 on normalized text (borrowed from dedupe_history.py's title
   196	    dedup, which treats <=0.75 as NOT a duplicate)."""
   197	    if normalize_owner(a_owner) != normalize_owner(b_owner):
   198	        return False
   199	    ratio = difflib.SequenceMatcher(None, _normalize_text(a_text), _normalize_text(b_text)).ratio()
   200	    return ratio > 0.75  # G-DEDUP-1
