    56	
    57	    def touch(self) -> None:
    58	        """Heartbeat. If our OWN lock file is gone (src/bus/meeting-brief.ts
    59	        unlinkSync stale-sweep, or another holder reclaimed it) we no longer
    60	        own the lease: mark it lost so the caller stops BEFORE further effects.
    61	        Silently continuing here would let two runs write concurrently and
    62	        would let this run release somebody else's lease (G0B2-13)."""
    63	        path = lock_path(self.claims_dir, self.name)
    64	        try:
    65	            os.utime(path, None)  # G-LOCK-2: heartbeat -- mtime bump, claimAgeMs treats mtime as authoritative
