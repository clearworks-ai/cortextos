    62	def _local_split_sections(text: str) -> tuple[str, list[tuple[str, str]]]:
    63	    """Byte-identical fallback to writeback_render._split_sections, kept local so
    64	    this module still works if that private helper is ever renamed/removed."""
    65	    lines = text.splitlines(keepends=True)
