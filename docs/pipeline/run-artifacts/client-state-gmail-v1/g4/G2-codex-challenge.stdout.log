   208	            f"  extraction: cached={cached} cost_usd={extraction.get('cost_usd')} "
   209	            f"model_receipt={extraction.get('model_receipt')}"
   210	        )
   211	        lines.append(f"  summary: {extraction.get('summary', '')}")
   212	        items = 0
   213	        for d in extraction.get("decisions") or []:
   214	            items += 1
   215	            lines.append(f"  decision: {d.get('text', '')} [quote: {d.get('quote', '')}]")
