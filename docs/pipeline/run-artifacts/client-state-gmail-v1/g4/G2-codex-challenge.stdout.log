   178	def normalize_owner(owner: str) -> str:
   179	    """Casefold + collapse whitespace, then the FR-008 alias map; unknown owners
   180	    pass through normalized but un-aliased (so "marcos ruiz" != "josh"). The map
   181	    folds the human-side aliases the model emits ("me", "Josh Weiss") AND the
   182	    bus's own assignee identities ("human", "user") onto "josh" -- G0B2-10."""
   183	    key = " ".join((owner or "").casefold().split())
   184	    return _OWNER_ALIASES.get(key, key)
