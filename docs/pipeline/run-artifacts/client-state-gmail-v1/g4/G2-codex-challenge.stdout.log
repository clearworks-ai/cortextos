   247	def list_open_tasks(runner) -> list[dict]:
   248	    """G0A-19/C8: enumerates BOTH human and build classes (`--open --class <cls>
   249	    --format json --limit 200` -- LIST_TASKS_MAX_LIMIT is 200, src/bus/task.ts:89,
   250	    so 200 is the deliberate limit, not 500). rc != 0 on EITHER call raises
   251	    TaskEnumerationError (G0B-8/G0B-11: never silently returns an empty
   252	    'authoritative' list on a failed enumeration)."""
   253	    merged: dict[object, dict] = {}
   254	    for cls in ("human", "build"):
   255	        argv = ["cortextos", "bus", "list-tasks", "--open", "--class", cls, "--format", "json", "--limit", "200"]
   256	        result = runner.run(argv)
   257	        if result.returncode != 0:  # G-TASK-2
   258	            raise TaskEnumerationError(
   259	                f"list-tasks --class {cls} rc={result.returncode}: {(result.stderr or '').strip()}"
   260	            )
   261	        try:
   262	            data = json.loads(result.stdout or "[]")
   263	        except json.JSONDecodeError as exc:
   264	            raise TaskEnumerationError(f"list-tasks --class {cls} stdout unparsable: {exc}") from exc
   265	        if not isinstance(data, list):
   266	            raise TaskEnumerationError(f"list-tasks --class {cls} returned non-list JSON")
   267	        for task in data:
   268	            key = task.get("id") if isinstance(task, dict) and task.get("id") is not None else id(task)
   269	            merged[key] = task
   270	    return list(merged.values())
