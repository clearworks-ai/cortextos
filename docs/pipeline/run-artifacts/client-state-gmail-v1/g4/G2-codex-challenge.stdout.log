   182	def gmail_section_lines(args: argparse.Namespace) -> tuple[list[str], str | None]:
   183	    """FR-009's client-state digest. Imports client_state_digest lazily and
   184	    catches every Exception (G-DIG-2) so a Gmail-side failure — a bad vault
   185	    path, a corrupt ledger, anything — never takes the Fireflies section down
   186	    with it (the reverse of the old G-07 bug)."""
   187	    try:
   188	        import client_state_digest
   189	        from observation_ledger import Ledger
   190	        from runner import SubprocessRunner
   191	
   192	        state_dir = Path(os.environ.get("CLIENT_STATE_DIR", REPO / "state/client-state"))
   193	        vault = Path(os.environ.get("CLIENT_STATE_VAULT", VAULT))
   194	        ledger = Ledger(state_dir / "observations.jsonl")
   195	        lines = client_state_digest.gmail_section(
   196	            state_dir, vault, ledger, datetime.now(timezone.utc), GMAIL_POLL_WINDOW_DAYS, SubprocessRunner()
   197	        )
   198	        return lines, None
   199	    except Exception as exc:  # noqa: BLE001 — G-DIG-2 sections fail independently
   200	        return [], f"{type(exc).__name__}: {exc}"
   201	
   202	
   203	def main(argv: list[str] | None = None) -> int:
   204	    parser = argparse.ArgumentParser()
   205	    parser.add_argument("--dry-run", action="store_true", help="print, do not send")
   206	    parser.add_argument("--days", type=int, default=7, help="how far back to look (Fireflies)")
   207	    args = parser.parse_args(argv)
   208	
   209	    # G0B-16: each section body is independently exception-guarded (inside
   210	    # fireflies_section / gmail_section_lines) -- neither call here can take
   211	    # the other section down with it, and main() itself now reads NOTHING that
   212	    # either section could fail on (G-DIG-4).
   213	    ff_lines, ff_err = fireflies_section(args)
   214	    gm_lines, gm_err = gmail_section_lines(args)
   215	
   216	    sections: list[str] = []
   217	    sections.append(f"⚠️ Fireflies section error: {ff_err}" if ff_err else "\n".join(ff_lines))
   218	    sections.append(f"⚠️ Gmail section error: {gm_err}" if gm_err else "\n".join(gm_lines))
   219	
   220	    message = "\n\n".join(sections)
   221	    print(message)
   222	    if args.dry_run:
   223	        return 0
   224	    return 0 if send_telegram(message) else 1
   225	
   226	
   227	if __name__ == "__main__":
   228	    raise SystemExit(main())

