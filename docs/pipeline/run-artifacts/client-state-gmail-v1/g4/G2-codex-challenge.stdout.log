    79	def window_queries(days: int, today: date) -> list[tuple[str, str]]:
    80	    """One (label, query) per calendar day covering EXACTLY the last `days` days ending
    81	    today (today included). Gmail after: is inclusive, before: is exclusive, so each
    82	    single day is after:<day> before:<day+1>."""
    83	    out: list[tuple[str, str]] = []
    84	    for offset in range(days - 1, -1, -1):  # G-SWEEP-1
    85	        day = today - timedelta(days=offset)
    86	        label = day.strftime("%Y-%m-%d")
    87	        query = _compose_query(_date_ops(day, day + timedelta(days=1)), None)
    88	        out.append((label, query))
    89	    return out
