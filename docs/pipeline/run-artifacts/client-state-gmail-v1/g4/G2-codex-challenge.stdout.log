   146	def new_violations(current: dict[str, Any], baseline: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:
   147	    """Items in `current` not present in `baseline`, matched by CANONICAL record:
   148	    (name/domain, sorted page-set tuple) for the two duplicate-declaration
   149	    sections, (ref, page) for missing refs (G-BASE-2 / G0B-14 fix — comparing by
   150	    name/domain KEY ALONE would grandfather a page added to an already-known
   151	    duplicate group, and comparing a missing ref by REF ALONE would grandfather
   152	    the SAME ref later going missing from a DIFFERENT page; the page must be
   153	    part of the identity on both sides)."""
   154	    out: dict[str, list[dict[str, Any]]] = {}
   155	    for section, key_name in (("org_name_multi", "name"), ("domain_multi", "domain")):
   156	        base_canon = {
   157	            (item[key_name], tuple(sorted(item.get("pages", []))))
   158	            for item in baseline.get(section, [])
   159	        }
   160	        out[section] = [
   161	            item
   162	            for item in current.get(section, [])
   163	            if (item[key_name], tuple(sorted(item.get("pages", [])))) not in base_canon
   164	        ]
   165	    base_refs = {(item["ref"], item.get("page")) for item in baseline.get("missing_gmail_refs", [])}
   166	    out["missing_gmail_refs"] = [
   167	        item
   168	        for item in current.get("missing_gmail_refs", [])
   169	        if (item["ref"], item.get("page")) not in base_refs  # G-BASE-2
   170	    ]
   171	    return out
