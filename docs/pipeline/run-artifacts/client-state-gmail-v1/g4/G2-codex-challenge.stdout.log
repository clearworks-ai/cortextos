   155	def latest_iso_timestamp(existing: str | None, candidate: str | None) -> str | None:
   156	    """Return the later valid ISO timestamp without regressing contact recency."""
   157	    if not candidate:
   158	        return existing
   159	
   160	    def parse(value: str) -> dt.datetime:
   161	        normalized = value.strip().replace("Z", "+00:00")
   162	        parsed = dt.datetime.fromisoformat(normalized)
   163	        if parsed.tzinfo is None:
   164	            parsed = parsed.replace(tzinfo=dt.timezone.utc)
   165	        return parsed.astimezone(dt.timezone.utc)
   166	
   167	    try:
   168	        candidate_dt = parse(candidate)
   169	    except (TypeError, ValueError):
   170	        raise ValueError(f"invalid --last-meaningful-contact timestamp: {candidate}")
   171	    if not existing:
   172	        return candidate_dt.isoformat()
   173	    try:
   174	        existing_dt = parse(existing)
   175	    except (TypeError, ValueError):
   176	        return candidate_dt.isoformat()
   177	    return candidate_dt.isoformat() if candidate_dt > existing_dt else existing
