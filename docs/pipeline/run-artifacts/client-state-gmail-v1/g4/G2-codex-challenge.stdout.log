   115	def fireflies_section(args: argparse.Namespace) -> tuple[list[str], str | None]:
   116	    """The original meeting-loop watch, logic byte-identical, now wrapped so
   117	    EVERY failure (missing key, list_transcripts raising, anything else)
   118	    returns ([], err) instead of exiting main() early (G-07 / G0B-16)."""
   119	    try:
   120	        # G-DIG-4 (G2A-6): the secrets file is THIS section's input and nothing
   121	        # else's, so it is read inside this section's own guard. main() used to
   122	        # read it before either section ran, so a missing or unreadable
   123	        # orgs/clearworksai/secrets.env crashed the whole watch and the Gmail
   124	        # digest -- which needs no secrets at all -- never rendered.
   125	        secrets = envparse.parse_env_file(brain_paths.secrets_path(REPO))
   126	        api_key = secrets.get("FIREFLIES_API_KEY")
   127	        if not api_key:
   128	            return [], "no FIREFLIES_API_KEY"
   129	
   130	        rows = list_transcripts(api_key, throttle_s=1.0)
   131	        cutoff = datetime.now(timezone.utc) - timedelta(days=args.days)
   132	        recent = [r for r in rows if _occurred(r) >= cutoff]
   133	        have = {p.name for p in ENVELOPES.iterdir() if p.is_dir()} if ENVELOPES.is_dir() else set()
   134	
   135	        missing, empty, incomplete = [], [], []
   136	        for row in sorted(recent, key=_occurred):
   137	            mid = str(row.get("id"))
   138	            if mid in have:
   139	                # 2026-09-14 (ported from main 8c956a0b): an envelope dir only
   140	                # proves FETCH happened. The receipt is written last, after
   141	                # extract -> resolve -> file -> phase 3; a run that died at any
   142	                # step (extract "Credit balance is too low", or the phase-3
   143	                # sign-check) leaves the envelope and no receipt, and this watch
   144	                # used to call that "filed". Key on the receipt instead.
   145	                if not (STATE / f"fireflies-{mid}" / "receipt.json").exists():
   146	                    incomplete.append((_occurred(row).date().isoformat(), mid, str(row.get("title") or "")[:48]))
   147	                continue
   148	            reason = _not_ready_reason(mid)
   149	            count = _sentence_count(reason)
   150	            entry = (_occurred(row).date().isoformat(), mid, str(row.get("title") or "")[:48], count)
   151	            (empty if count is not None and count < MIN_SENTENCES else missing).append(entry)
   152	
   153	        hub, bridge = _probe(HUB_HEALTH), _probe(BRIDGE_HEALTH)
   154	        transport_ok = hub == "ok" and bridge == "ok"
   155	        newest = max((_occurred(r) for r in rows), default=None)
   156	
   157	        if not missing and not incomplete and transport_ok:
   158	            lines = [
   159	                f"Meeting loop OK — {len(recent)} transcript(s) in the last {args.days}d, all filed (receipts present).",
   160	                f"Newest: {newest.date().isoformat() if newest else 'none'} · hub {hub} · bridge {bridge}",
   161	            ]
   162	            if empty:
   163	                lines.append(f"({len(empty)} empty recording(s) skipped, which is correct.)")
   164	        else:
   165	            lines = ["⚠️ Meeting loop needs a look."]
   166	            if missing:
   167	                lines.append(f"\n{len(missing)} transcript(s) NOT in the vault and not empty:")
   168	                lines += [f"- {d} {t} ({m})" for d, m, t, _ in missing[:10]]
   169	            if incomplete:
   170	                lines.append(f"\n{len(incomplete)} transcript(s) fetched but NOT processed (no receipt — "
   171	                             "the run died after fetch; re-run run_meeting.py --apply for each):")
   172	                lines += [f"- {d} {t} ({m})" for d, m, t in incomplete[:10]]
   173	            if not transport_ok:
   174	                lines.append(f"\nTransport: hub {hub} · bridge {bridge}")
   175	            lines.append("\nEvery failure in this chain has been silent — check the hub logs "
   176	                         "(railway logs --service webhook-hub) for relay_failed.")
   177	        return lines, None
   178	    except Exception as exc:  # noqa: BLE001 — G0B-16: sections fail independently
   179	        return [], f"{type(exc).__name__}: {exc}"
   180	
