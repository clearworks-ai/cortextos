   188	def _parse_receipt_ts(value: Any) -> datetime | None:
   189	    try:
   190	        dt = datetime.fromisoformat(str(value))
   191	    except (TypeError, ValueError):
   192	        return None
   193	    return dt if dt.tzinfo is not None else dt.replace(tzinfo=timezone.utc)
