    93	export function classifyTask(task: Task): TaskClass {
    94	  const by = task.created_by || '';
    95	  const title = task.title || '';
    96	  if (
    97	    SYSTEM_TASK_CREATOR_RE.test(by)
    98	    || task.project === 'system'
    99	    || SYSTEM_TITLE_RE.test(title)
   100	    || AUDIT_BOOKKEEPING_TITLE_RE.test(title)
   101	  ) {
   102	    return 'system';
   103	  }
   104	  if (
   105	    task.assigned_to === 'human'
   106	    || task.assigned_to === 'user'
   107	    || task.project === 'human-tasks'
   108	    || HUMAN_TITLE_RE.test(title)
   109	    || task.type === 'human' // G-BUS-3: an explicit type:human task is human-class whoever owns it
   110	  ) {
   111	    return 'human';
   112	  }
   113	  return 'build';
   114	}
