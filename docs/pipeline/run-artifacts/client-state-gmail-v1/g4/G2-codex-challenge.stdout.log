   348	def _cmd_write_baseline(args: argparse.Namespace) -> int:
   349	    state_dir = Path(args.state_dir)
   350	    vault = Path(args.vault)
   351	    ledger_path = Path(args.ledger) if args.ledger else state_dir / "observations.jsonl"
   352	    ledger = Ledger(ledger_path)
   353	    now_iso = datetime.now(timezone.utc).isoformat()
   354	    inv = compute_invariants(vault, ledger, now_iso)
