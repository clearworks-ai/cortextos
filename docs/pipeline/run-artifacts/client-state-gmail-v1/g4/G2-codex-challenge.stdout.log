   186	def _resolution_key(r: Resolution) -> tuple[str, str]:
   187	    """G0B3-1: merge identity is (slug, normalized email) — NOT contact_id.
   188	    A sender whose contact is auto-created changes contact_id from None to the
   189	    new id between runs, so keying on it made the same counterparty look like a
   190	    different resolution and lost its carried-forward `filed`/`effects`."""
   191	    return (r.slug, (r.email or "").strip().lower())
