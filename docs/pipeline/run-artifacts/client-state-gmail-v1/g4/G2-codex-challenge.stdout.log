   309	        return None
   310	    try:
   311	        last_dt = datetime.fromisoformat(last)
   312	    except ValueError:
   313	        return None
   314	    if last_dt.tzinfo is None:
   315	        last_dt = last_dt.replace(tzinfo=timezone.utc)
   316	    now_dt = now if now.tzinfo is not None else now.replace(tzinfo=timezone.utc)
   317	    delta_days = (now_dt - last_dt).total_seconds() / 86400.0
   318	    if delta_days <= window_days:
   319	        return None
   320	    n = math.ceil(delta_days)  # G-RECEIPT-2: N = ceil(days since last_success_at)
   321	    return (
   322	        f"Gmail poller gap: last success {last} is {n} day(s) old "
   323	        f"(window {window_days}d) -- repair with `--days {n}`."
   324	    )
