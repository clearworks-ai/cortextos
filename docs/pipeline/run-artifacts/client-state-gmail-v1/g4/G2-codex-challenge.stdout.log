   262	def _open_email_titles_still_open(ledger: Ledger, open_tasks: list[dict]) -> list[str]:
   263	    """C8: join ledger.open_email_tasks() ids against the CURRENTLY open task
   264	    list (list_open_tasks) and keep only titles for tasks still open -- a
   265	    completed/cancelled email-sourced task must never keep suppressing a fresh
   266	    commitment (G0B-8)."""
   267	    open_ids = {t.get("id") for t in open_tasks}
   268	    return [t["title"] for t in ledger.open_email_tasks() if t.get("id") in open_ids]
