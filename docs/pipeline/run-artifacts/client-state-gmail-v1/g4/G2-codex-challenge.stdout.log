    99	def send_telegram(text: str) -> bool:
   100	    env = dict(os.environ)
   101	    env["CTX_AGENT_DIR"] = str(TELEGRAM_AGENT_DIR)
   102	    try:
   103	        result = subprocess.run(
   104	            ["cortextos", "bus", "send-telegram", TELEGRAM_CHAT_ID, text],
   105	            capture_output=True, text=True, timeout=60, env=env,
   106	        )
   107	        if result.returncode != 0:
   108	            print(f"telegram failed rc={result.returncode}: {result.stderr.strip()[:200]}", file=sys.stderr)
   109	        return result.returncode == 0
   110	    except (subprocess.TimeoutExpired, OSError) as exc:
   111	        print(f"telegram failed: {exc}", file=sys.stderr)
   112	        return False
