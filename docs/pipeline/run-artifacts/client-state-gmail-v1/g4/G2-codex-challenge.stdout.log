   356	def cached_or_extract(
   357	    cache: "Ledger | ObservationRow | None",
   358	    msg: Message,
   359	    context: list[ContextItem],
   360	    slugs: list[str],
   361	    runner: Runner,
   362	    *,
   363	    max_usd: float,
   364	    spent_usd: float,
   365	) -> tuple[dict[str, Any], bool]:
   366	    """FR-001: at most one LLM call per (source_ref, content_digest,
   367	    bound-entity set). Reuses the newest cached extraction in the ledger whose
   368	    stamped `identity` matches THIS call's (source_ref, digest, slugs);
   369	    otherwise runs extract() — this is the late-bound-entity widen-and-rerun
   370	    path (a newly-resolved entity widens `slugs`, the identity no longer
   371	    matches, and the cache is refreshed with the wider open-items context)."""
   372	    source_ref = f"gmail:{msg.id}"
   373	    digest = content_digest(msg.subject, msg.body_text, msg.from_email)
   374	    cached = _cached_extraction(cache, extraction_identity(source_ref, digest, slugs))
   375	    if cached is not None:  # G-EXT-3
   376	        # identity match — reuse, no LLM call. The cached matches_open_item
   377	        # indices are re-resolved against the context this invocation just
   378	        # built (G0B2-11).
   379	        return rebind_cached_matches(cached, context), False
   380	    stamped = extract(runner, msg, context, max_usd=max_usd, spent_usd=spent_usd, slugs=slugs)
   381	    return stamped, True

