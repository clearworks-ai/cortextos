   196	def _poller_health_lines(receipt: dict | None) -> list[str]:
   197	    """FR-009: the warning lines a receipt that CANNOT prove a healthy poller
   198	    owes the digest. A missing, unreadable or never-stamped receipt says "no
   199	    successful run on record"; an `error` stamped AFTER `last_success_at`
   200	    (record_failure deliberately preserves the older last_success_at, so
   201	    gap_line alone still reads "fresh") says the last run FAILED. An error that
   202	    predates the last success is a repaired poller and yields nothing, so the
   203	    gate can never become a permanent warning. An unparseable `failed_at` is
   204	    treated as current -- fail-closed."""
   205	    last_success = (receipt or {}).get("last_success_at")
   206	    if not last_success:
   207	        return ["- poller: no successful run on record — run-receipt.json missing, unreadable or never stamped"]
   208	    error = str((receipt or {}).get("error") or "").strip()
   209	    if not error:
   210	        return []
   211	    failed_at = (receipt or {}).get("failed_at")
   212	    failed_dt = _parse_receipt_ts(failed_at)
   213	    success_dt = _parse_receipt_ts(last_success)
   214	    if failed_dt is not None and success_dt is not None and failed_dt <= success_dt:
   215	        return []
   216	    return [f"- poller: last run FAILED at {failed_at or 'unknown'}: {error}"]
   217	
   218	
   219	def _superseded_task_ids(ledger: Ledger, row: ObservationRow) -> set[str]:
   220	    # G-SUPER-1 (G0B-15): the digest a revision supersedes can be arbitrarily
   221	    # older than the 24h window this digest covers, so the search reads FULL
   222	    # ledger history (rows_since(_EPOCH_SENTINEL)), never just `rows_since(now
   223	    # - 1 day)` — filtered to the exact row this revision's revision_of names.
   224	    ids: set[str] = set()
   225	    for hist in ledger.rows_since(_EPOCH_SENTINEL):
   226	        if hist.source_ref != row.source_ref or hist.content_digest != row.revision_of:
   227	            continue
   228	        for w in hist.writes:
   229	            if w.startswith("task:"):
   230	                ids.add(_task_id(w))
   231	    return ids
   232	
   233	
   234	def gmail_section(
   235	    state_dir: Path,
   236	    vault: Path,
   237	    ledger: Ledger,
   238	    now: datetime,
   239	    window_days: int,
   240	    runner: Runner,
   241	) -> list[str]:
   242	    state_dir = Path(state_dir)
   243	    since = (now - timedelta(days=1)).isoformat()
   244	    rows = ledger.rows_since(since)
   245	
   246	    change_lines: list[str] = []
   247	
   248	    # G-SUPER-1: one list_open_tasks() enumeration covers every revision row
   249	    # in this window's current-status join -- only called when there is
   250	    # something to join against.
   251	    open_tasks_by_id: dict[str, dict[str, Any]] = {}
   252	    if any(row.revision_of for row in rows):
   253	        open_tasks_by_id = {t["id"]: t for t in list_open_tasks(runner)}
   254	
   255	    for row in rows:
   256	        # G0B-17: EVERY per-row line -- writes (with the extraction summary),
   257	        # suppressions, escalations and the revision marker -- comes from the
   258	        # SHARED projection (client_state_projections.plan_digest_line), the
   259	        # same rendering the dry-run preview uses. This loop adds ONLY what that
   260	        # projection cannot know: the join against currently-open tasks below.
   261	        # It used to re-emit the revision/suppression/escalation events in its
   262	        # own wording on top of the projection's, so a row with writes AND any
   263	        # of those reported each one twice. G0B2-4: a SIMULATED (dry-run) row's
   264	        # effective writes are its `planned_writes`, so the G4 item-6 dry-run
   265	        # digest reports what the run previewed instead of "0 changes".
   266	        change_lines.extend(plan_digest_line(row))
   267	        if row.revision_of:
   268	            for tid in sorted(_superseded_task_ids(ledger, row)):
   269	                task = open_tasks_by_id.get(tid)
   270	                if task is not None:
   271	                    # FR-001 D-02: any OPEN task derived from the superseded
   272	                    # digest is flagged for review, never auto-closed.
   273	                    change_lines.append(f"- evidence superseded — review: task:{tid} {task['title']}")
   274	
   275	    ignored_refs: set[str] = set()
   276	    ignored_senders: set[str] = set()
   277	    domain_counts: Counter[str] = Counter()
   278	    for row in rows:
   279	        for res in row.resolutions:
   280	            if res.outcome != "ignored":
   281	                continue
   282	            ignored_refs.add(row.source_ref)
   283	            ignored_senders.add(res.email or row.source_ref)
   284	            dom = _sender_domain(res.email)
   285	            if dom:
   286	                domain_counts[dom] += 1
   287	    if ignored_refs:
   288	        line = f"- ignored (no-known-entity): {len(ignored_refs)} messages from {len(ignored_senders)} senders"
   289	        top = ", ".join(f"{d} ({n})" for d, n in domain_counts.most_common(5))
   290	        if top:
   291	            line += f" — top: {top}"
   292	        change_lines.append(line)
   293	
   294	    receipt = read_receipt(state_dir)
   295	    for trunc in (receipt or {}).get("truncation", []):
   296	        change_lines.append(f"- truncated: {trunc.get('day')} ({trunc.get('count')} msgs, cap reached)")
   297	
   298	    # G-DIG-3 (FR-009): the collapsed OK sentence below CLAIMS a healthy poller
   299	    # ("poller last success <X>"), so a receipt that cannot prove one must
   300	    # speak. Appending to change_lines is what makes the claim unreachable --
   301	    # the G-DIG-1 collapse already refuses to fire while any change line
   302	    # exists, so there is exactly ONE place the OK sentence is gated.
   303	    change_lines.extend(_poller_health_lines(receipt))  # G-DIG-3
   304	
   305	    gap = gap_line(receipt, window_days, now)
   306	
   307	    # G-BASE-1 (G0B-14): NO auto-baseline. A missing or corrupt baseline is an
   308	    # ERROR the digest reports -- it is never written here; `write-baseline`
   309	    # is a deliberate, one-time CLI step the activate goal commits.
   310	    baseline = load_baseline(state_dir)
   311	    if baseline is None:
   312	        invariant_lines = ["- invariants: baseline missing — run write-baseline"]
   313	    else:
   314	        nv = new_violations(compute_invariants(vault, ledger, baseline["epoch"]), baseline["invariants"])
   315	        invariant_lines = []
   316	        for row in nv["org_name_multi"]:
   317	            invariant_lines.append(
   318	                f"- invariant: CRM org name {row['name']!r} declared on {len(row['pages'])} pages: "
   319	                f"{', '.join(row['pages'])}"
   320	            )
   321	        for row in nv["domain_multi"]:
   322	            invariant_lines.append(
   323	                f"- invariant: domain {row['domain']!r} declared on {len(row['pages'])} pages: "
   324	                f"{', '.join(row['pages'])}"
   325	            )
   326	        for row in nv["missing_gmail_refs"]:
   327	            invariant_lines.append(
   328	                f"- invariant: missing ledger ref {row['ref']} (page {row['page']}, dated {row['date']})"
   329	            )
   330	        if not invariant_lines:
   331	            invariant_lines = ["- invariants: OK"]
   332	
   333	    # G-DIG-1: a silent watcher is indistinguishable from a dead one, so the
   334	    # single-line OK collapses ONLY when there is truly nothing to report
   335	    # (which also means a missing baseline NEVER collapses -- its error line
   336	    # is not "- invariants: OK").
   337	    if not change_lines and gap is None and invariant_lines == ["- invariants: OK"]:
   338	        last_success = (receipt or {}).get("last_success_at", "unknown")
   339	        return [f"Client state (Gmail) OK — 0 changes in 24h, invariants OK, poller last success {last_success}"]
   340	
   341	    lines = ["Client state (Gmail) — last 24h", *change_lines]
   342	    if gap:
   343	        lines.append(gap)
   344	    lines.extend(invariant_lines)
   345	    return lines
   346	
