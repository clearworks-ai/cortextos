    90	def _sentence_count(reason: str | None) -> int | None:
    91	    if not reason or "sentences=" not in reason:
    92	        return None
    93	    try:
    94	        return int(reason.split("sentences=", 1)[1].split()[0].strip())
    95	    except (ValueError, IndexError):
    96	        return None
