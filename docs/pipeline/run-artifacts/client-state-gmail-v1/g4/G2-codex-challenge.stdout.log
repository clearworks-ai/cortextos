   101	# FR-008 page-lock bounds. A page is normally free; anything past a few minutes
   102	# means another holder is wedged, and waiting on it silently is what let a live
   103	# run's 60-minute claim go stale underneath it (G2B-4).
   104	PAGE_LOCK_TIMEOUT_S = 300.0
   105	PAGE_LOCK_POLL_S = 2.0
