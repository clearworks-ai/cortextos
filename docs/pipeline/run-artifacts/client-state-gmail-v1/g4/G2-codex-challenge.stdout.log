   116	
   117	def _page_lock_path(page: Path) -> Path:
   118	    # Byte-identical to meeting_writeback.client_file_lock's sibling lockfile,
   119	    # so the meeting pipeline and this one still exclude each other.
   120	    return page.with_name(page.name + ".lock")
