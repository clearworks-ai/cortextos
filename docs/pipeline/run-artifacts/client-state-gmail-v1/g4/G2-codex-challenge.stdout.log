   100	@dataclass
   101	class Heartbeat:
   102	    """G0B3-6: a time-bounded heartbeat for the WHOLE acquired interval.
   103	
   104	    Touching once per message is not enough: `gmail_source.sweep` runs before the
   105	    first message and can issue a full-window query plus up to 14 daily ones,
   106	    each through a runner whose default timeout is 120s; and a single message's
   107	    read + extraction + writes have no natural boundary either. Both can outlast
   108	    the staleness window while the run is very much alive.
   109	
   110	    `tick()` is cheap and idempotent — it touches only when at least
   111	    `interval_s` has elapsed on a MONOTONIC clock (injectable, so a test can
   112	    simulate a long sweep without sleeping). Losing the lock raises LeaseLost at
   113	    the next tick, so the run stops before its next effect."""
   114	
   115	    lease: "Lease"
   116	    clock: Callable[[], float] = time.monotonic
   117	    interval_s: float = HEARTBEAT_INTERVAL_S
   118	    _last: float = field(default=0.0, init=False)
   119	    touches: int = field(default=0, init=False)
   120	
   121	    def __post_init__(self) -> None:
   122	        self._last = self.clock()
   123	
   124	    def tick(self) -> None:
   125	        # Liveness is checked on EVERY tick (one stat — negligible next to a
   126	        # subprocess), so loss stops the run immediately rather than up to
   127	        # `interval_s` later. The mtime TOUCH is what is rate-limited.
   128	        if not self.lease.lost and not lock_path(self.lease.claims_dir, self.lease.name).exists():
   129	            self.lease.lost = True
   130	        if self.lease.lost:
   131	            raise LeaseLost(
   132	                "client-state-gmail lease disappeared mid-run — stopping before further writes"
   133	            )
   134	        now = self.clock()
   135	        if now - self._last < self.interval_s:
   136	            return
   137	        self._last = now
   138	        self.lease.touch()          # G-LOCK-8
   139	        self.touches += 1
   140	        if self.lease.lost:
   141	            raise LeaseLost(
   142	                "client-state-gmail lease disappeared mid-run — stopping before further writes"
   143	            )
