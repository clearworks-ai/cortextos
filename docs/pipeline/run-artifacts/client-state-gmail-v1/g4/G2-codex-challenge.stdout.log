   342	def _cached_extraction(cache: "Ledger | ObservationRow | None", identity: str) -> dict[str, Any] | None:
   343	    """The stamped extraction for `identity`, from wherever the caller keeps it.
   344	
   345	    A Ledger searches its WHOLE history (G2B-2) -- a later extraction-less row
   346	    must not hide a call already paid for. A bare ObservationRow is the narrow
   347	    single-row form the unit tests pin directly."""
   348	    if cache is None:
   349	        return None
   350	    if isinstance(cache, Ledger):
   351	        return cache.cached_extraction(identity)
   352	    cached = cache.extraction
   353	    return cached if cached and cached.get("identity") == identity else None
