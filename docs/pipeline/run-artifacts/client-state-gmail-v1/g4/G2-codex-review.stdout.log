   127	    def is_terminal(self, source_ref: str, digest: str) -> bool:
   128	        """A row is terminal only when every resolution on the LATEST row for
   129	        this source_ref/digest is filed AND the row is a REAL one. A dry-run
   130	        row is `simulated` -- it records what WOULD have been written
   131	        (`planned_writes`), never what was, so it must never make the
   132	        subsequent LIVE run a no-op (G0A2-2)."""
   133	        row = self.latest(source_ref)
   134	        if row is None or row.content_digest != digest:
   135	            return False
   136	        if row.simulated:  # G-LEDGER-6: a simulated (dry-run) row is never terminal
   137	            return False
   138	        if row.partial:  # G-LEDGER-7: a mid-message failure row is never terminal
   139	            return False
   140	        if not row.resolutions:
   141	            return False
   142	        return all(r.outcome == "filed" for r in row.resolutions)  # G-LEDGER-2
   143	
   144	    def rows_since(self, since_iso: str) -> list[ObservationRow]:
   145	        return [r for r in self._read_rows() if r.observed_at >= since_iso]
