   128	def effective_writes(row: ObservationRow) -> list[str]:
   129	    """The write tokens a digest should render for `row`. A simulated (dry-run)
   130	    row carries `planned_writes` -- what the live run WOULD write -- while
   131	    `writes` stays empty, so nothing downstream can mistake a preview for a
   132	    completed effect (G0A2-2/G0B2-4)."""
   133	    return list(row.planned_writes) if row.simulated else list(row.writes)
