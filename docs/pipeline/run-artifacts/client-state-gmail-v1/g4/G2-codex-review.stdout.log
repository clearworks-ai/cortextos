   110	def message_outcome(resolutions: list[Resolution]) -> str:
   111	    """The message-level outcome a preview block declares (G0B3-4): `filed` when
   112	    anything was filed, else `escalated` when anything escalated, else
   113	    `ignored`. It tells the G4 checker which per-field requirements apply —
   114	    an ignored or escalated message legitimately has no extraction, CRM row,
   115	    page diff, task line or grounding quote."""
   116	    outcomes = {r.outcome for r in resolutions}
   117	    if "filed" in outcomes or "partial" in outcomes:
   118	        return "filed"
   119	    if "escalated" in outcomes:
   120	        return "escalated"
   121	    return "ignored"
