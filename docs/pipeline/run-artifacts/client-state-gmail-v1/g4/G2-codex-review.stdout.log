   179	def _validate_against_email_schema(value: Any, schema: dict[str, Any], path: str) -> None:
   180	    """G0B-12/C9: typed walker driven by email_extraction.schema.json — see
   181	    Task 9 for the full rationale/deviation note."""
   182	    if "const" in schema and value != schema["const"]:
   183	        raise ValueError(f"{path}: expected const {schema['const']!r}, got {value!r}")
   184	
   185	    type_spec = schema.get("type")
   186	    if type_spec is not None:
   187	        type_names = type_spec if isinstance(type_spec, list) else [type_spec]
   188	        if not any(_matches_json_type(value, t) for t in type_names):
   189	            raise ValueError(f"{path}: expected {'/'.join(type_names)}, got {type(value).__name__}")
   190	
   191	    if isinstance(value, dict) and "properties" in schema:
   192	        properties = schema["properties"]
   193	        required = schema.get("required") or []
   194	        missing = [k for k in required if k not in value]
   195	        if missing:
   196	            raise ValueError(f"{path}: missing keys {sorted(missing)}")
   197	        if schema.get("additionalProperties") is False:
   198	            extra = set(value) - set(properties)
   199	            if extra:
   200	                raise ValueError(f"{path}: unknown keys {sorted(extra)}")
   201	        for key, subschema in properties.items():
   202	            if key in value:
   203	                child_path = f"{path}.{key}" if path else key
   204	                _validate_against_email_schema(value[key], subschema, child_path)
   205	    elif isinstance(value, list) and "items" in schema:
   206	        item_schema = schema["items"]
   207	        for i, item in enumerate(value):
   208	            _validate_against_email_schema(item, item_schema, f"{path}[{i}]")
   209	
