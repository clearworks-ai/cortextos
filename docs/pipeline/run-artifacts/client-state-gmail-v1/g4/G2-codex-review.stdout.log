   125	def _merge_resolutions(prior_same_digest: ObservationRow | None, fresh: list[Resolution]) -> list[Resolution]:
   126	    """G0B-3 / G0B3-1: carry forward every resolution ALREADY filed on the prior
   127	    row for this exact digest -- never re-process it. For one NOT yet filed,
   128	    carry its LANDED EFFECT KEYS (and any contact_id it earned) onto the fresh
   129	    resolution, so the retry completes only what is still missing and never
   130	    replays a landed effect. Everything else is re-evaluated afresh: an
   131	    escalated/ignored resolution is re-checked every run (a cheap closed-sets
   132	    re-check, no LLM call), and a genuinely new counterparty is 'pending'."""
   133	    if prior_same_digest is None:
   134	        return fresh
   135	    prior_by_key = {_resolution_key(r): r for r in prior_same_digest.resolutions}
   136	    merged: list[Resolution] = []
   137	    seen: set[tuple[str, str]] = set()
   138	    for r in fresh:
   139	        key = _resolution_key(r)
   140	        seen.add(key)
   141	        old = prior_by_key.get(key)
   142	        if old is not None and old.outcome == "filed":  # G-MERGE-1
   143	            merged.append(old)
   144	            continue
   145	        if old is not None:
   146	            r.effects = list(old.effects)  # G-MERGE-2: landed effects survive the retry
   147	            if old.contact_id and not r.contact_id:
   148	                r.contact_id = old.contact_id
   149	        merged.append(r)
   150	    for key, old in prior_by_key.items():
   151	        # G-MERGE-3: a counterparty the resolver no longer produces (a contact
   152	        # removed from the CRM, a page whose domains line changed) but which we
   153	        # ALREADY filed must stay on the row -- dropping it would make the row
   154	        # look complete-but-smaller and lose the record of a real write.
   155	        if key not in seen and old.outcome == "filed":  # G-MERGE-3
   156	            merged.append(old)
   157	    return merged
