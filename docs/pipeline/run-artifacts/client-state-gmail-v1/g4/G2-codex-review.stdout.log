    37	def plan_history_entry(msg: Message, extraction: dict[str, Any], source_ref: str, revision_of: str | None) -> HistoryEntry:
    38	    """G-HIST-1/G-PARITY-2: the ONE place a Gmail message + its extraction become
    39	    a HistoryEntry -- both the dry-run diff preview and the live apply_history
    40	    call build the entry through this function."""
    41	    entry_date, date_unparsed = _history_date(msg.date_iso)
    42	    summary = str(extraction.get("summary") or "")
    43	    if date_unparsed:
    44	        summary = (summary + " [date: unparsed]").strip()
    45	    return HistoryEntry(
    46	        date=entry_date,
    47	        subject=msg.subject,
    48	        source_ref=source_ref,
    49	        summary=summary,
    50	        decisions=[str(d.get("text") or "") for d in (extraction.get("decisions") or [])],
    51	        open_questions=[str(q.get("text") or "") for q in (extraction.get("open_questions") or [])],
    52	        revision_of=revision_of,
    53	    )
