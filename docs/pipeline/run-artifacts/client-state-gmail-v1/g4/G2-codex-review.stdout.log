    55	            self.lost = True  # G-LOCK-5
    56	
    57	    def release(self) -> None:
    58	        """Releases the lease. Raises LeaseReleaseError when the CLI refuses or
    59	        never returns: a failed release leaves the lock live for up to its TTL,
    60	        so every later poll refuses while this run claims success (G0B3-11)."""
    61	        if self.lost:
    62	            # G-LOCK-6: never release a lease we no longer own -- the lock file
    63	            # under our name may now belong to the run that reclaimed it.
    64	            return
    65	        argv = [
    66	            "cortextos",
    67	            "bus",
    68	            "meeting-brief-release",
    69	            self.name,
    70	            "--claims-dir",
    71	            str(self.claims_dir),
    72	        ]
