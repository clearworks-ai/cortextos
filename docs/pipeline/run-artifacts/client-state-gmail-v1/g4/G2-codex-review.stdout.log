   591	            result.filed += filed
   592	            result.escalated += escalated
   593	            result.ignored += ignored
   594	
   595	        receipt = {
   596	            "last_success_at": cfg.now.isoformat(), "window_days": cfg.days,
   597	            "message_count": len(messages_raw), "truncation": truncation, "cost_usd": state.cost,
   598	        }
   599	        write_receipt(cfg.state_dir, receipt)  # persisted in BOTH dry-run and live (C7/G0A-3)
   600	        result.cost_usd = state.cost
   601	        return result
   602	    except extract_email.BudgetExceeded as exc:
   603	        # G0B-6: the exception's own already-paid extraction (cost/model_receipt/
   604	        # cache) must not be discarded -- add its cost and persist a receipt that
   605	        # carries the REAL partial cost, never falsely claiming success.
   606	        state.cost += float(exc.extraction.get("cost_usd", 0.0))  # G-BUDGET-1
