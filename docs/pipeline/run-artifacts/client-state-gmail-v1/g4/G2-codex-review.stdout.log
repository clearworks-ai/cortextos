   205	    body = part.get("body") or {}
   206	    data = body.get("data")
   207	    if mime == "text/plain" and data:
   208	        padded = data + "=" * (-len(data) % 4)
   209	        try:
   210	            return base64.urlsafe_b64decode(padded).decode("utf-8", "replace")
   211	        except Exception:
   212	            return ""
   213	    for sub in part.get("parts", []) or []:
   214	        found = _find_plain_body(sub)
   215	        if found:
   216	            return found
   217	    return ""
