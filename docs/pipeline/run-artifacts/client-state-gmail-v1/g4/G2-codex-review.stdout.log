    45	def compute_invariants(vault: Path, ledger: Ledger, epoch_iso: str) -> dict[str, list[dict[str, Any]]]:
    46	    """{"org_name_multi": [...], "domain_multi": [...], "missing_gmail_refs": [...]}.
    47	
    48	    Reuses resolve_meeting's page-declaration readers (_domains_from_text,
    49	    _org_names_from_text) PER PAGE rather than via load_closed_sets, whose
    50	    domain_to_slug/org_name_to_slug maps collapse duplicates into a single
    51	    last-writer-wins key and so cannot detect the duplicate itself
    52	    (resolve_meeting.py:295-352) — exactly the gap these invariants cover.
    53	    """
    54	    brain = org_brain_root(Path(vault))
    55	    org_pages: dict[str, dict[str, Any]] = {}
    56	    domain_pages: dict[str, list[str]] = {}
    57	    missing_refs: list[dict[str, str]] = []
    58	    epoch_date = str(epoch_iso)[:10]
    59	    known_refs = ledger.distinct_refs()
    60	
    61	    for folder in _PAGE_FOLDERS:
    62	        d = brain / folder
    63	        if not d.is_dir():
    64	            continue
    65	        for path in sorted(d.glob("*.md")):
    66	            if path.stem.startswith("_"):
    67	                continue
    68	            text = path.read_text(encoding="utf-8")
    69	
    70	            for oname in _org_names_from_text(text):
    71	                key = _norm_title(oname)
    72	                if not key:
    73	                    continue
    74	                entry = org_pages.setdefault(key, {"name": oname, "pages": []})
    75	                if path.stem not in entry["pages"]:
    76	                    entry["pages"].append(path.stem)
    77	
    78	            for dom in _domains_from_text(text):
