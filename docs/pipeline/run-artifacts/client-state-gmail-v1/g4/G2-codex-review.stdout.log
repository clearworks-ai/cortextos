   342	def cached_or_extract(
   343	    ledger_latest_row: ObservationRow | None,
   344	    msg: Message,
   345	    context: list[ContextItem],
   346	    slugs: list[str],
   347	    runner: Runner,
   348	    *,
   349	    max_usd: float,
   350	    spent_usd: float,
   351	) -> tuple[dict[str, Any], bool]:
   352	    """FR-001: at most one LLM call per (source_ref, content_digest,
   353	    bound-entity set). Reuses the latest ledger row's cached extraction when
   354	    its stamped `identity` matches THIS call's (source_ref, digest, slugs);
   355	    otherwise runs extract() — this is the late-bound-entity widen-and-rerun
   356	    path (a newly-resolved entity widens `slugs`, the identity no longer
   357	    matches, and the cache is refreshed with the wider open-items context)."""
   358	    source_ref = f"gmail:{msg.id}"
   359	    digest = content_digest(msg.subject, msg.body_text, msg.from_email)
   360	    if ledger_latest_row is not None:
   361	        cached = ledger_latest_row.extraction
   362	        if cached and cached.get("identity") == extraction_identity(source_ref, digest, slugs):
   363	            # G-EXT-3: identity match — reuse, no LLM call. The cached
   364	            # matches_open_item indices are re-resolved against the context
   365	            # this invocation just built (G0B2-11).
   366	            return rebind_cached_matches(cached, context), False
   367	    stamped = extract(runner, msg, context, max_usd=max_usd, spent_usd=spent_usd, slugs=slugs)
   368	    return stamped, True

