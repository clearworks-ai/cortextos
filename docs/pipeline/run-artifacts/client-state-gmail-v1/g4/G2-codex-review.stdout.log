   188	def _poller_health_lines(receipt: dict | None) -> list[str]:
   189	    """FR-009: the warning lines a receipt that CANNOT prove a healthy poller
   190	    owes the digest. A missing, unreadable or never-stamped receipt says "no
   191	    successful run on record"; an `error` stamped AFTER `last_success_at`
   192	    (record_failure deliberately preserves the older last_success_at, so
   193	    gap_line alone still reads "fresh") says the last run FAILED. An error that
   194	    predates the last success is a repaired poller and yields nothing, so the
   195	    gate can never become a permanent warning. An unparseable `failed_at` is
   196	    treated as current -- fail-closed."""
   197	    last_success = (receipt or {}).get("last_success_at")
   198	    if not last_success:
   199	        return ["- poller: no successful run on record — run-receipt.json missing, unreadable or never stamped"]
   200	    error = str((receipt or {}).get("error") or "").strip()
   201	    if not error:
   202	        return []
   203	    failed_at = (receipt or {}).get("failed_at")
   204	    failed_dt = _parse_receipt_ts(failed_at)
   205	    success_dt = _parse_receipt_ts(last_success)
   206	    if failed_dt is not None and success_dt is not None and failed_dt <= success_dt:
   207	        return []
   208	    return [f"- poller: last run FAILED at {failed_at or 'unknown'}: {error}"]
