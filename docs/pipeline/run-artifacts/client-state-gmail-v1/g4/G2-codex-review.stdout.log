   248	def extract(
   249	    runner: Runner,
   250	    msg: Message,
   251	    context: list[ContextItem],
   252	    *,
   253	    max_usd: float,
   254	    spent_usd: float,
   255	    slugs: list[str],
   256	) -> dict[str, Any]:
   257	    """Runs exactly one bounded claude -p call, quote-gates the result against
   258	    the email body, and stamps cost/identity.
   259	
   260	    Deviation from the skeleton signature: adds a required keyword-only
   261	    `slugs: list[str]` — see Task 10.
   262	    """
   263	    prompt = build_prompt(msg, context)
   264	    proc = runner.run(list(CLAUDE_ARGV), input=prompt)  # G-EXT-2
   265	    if proc.returncode != 0:
   266	        raise ExtractionError(_claude_failure_reason(proc))
   267	    try:
   268	        model_obj, wrapper = _parse_claude_stdout(proc.stdout)
   269	        validate_email_extraction(model_obj, len(context))
   270	    except (ValueError, json.JSONDecodeError) as exc:
   271	        raise ExtractionError(str(exc)) from exc
   272	
   273	    source = {"text_units": [{"text": msg.body_text}]}
   274	    gated = quote_gate(model_obj, source)
   275	
   276	    cost_usd = float(wrapper.get("total_cost_usd") or 0)
   277	    model_usage = wrapper.get("modelUsage") or {}
   278	    model_receipt = ",".join(sorted(model_usage.keys())) or "unverified"
   279	
   280	    source_ref = f"gmail:{msg.id}"
   281	    digest = content_digest(msg.subject, msg.body_text, msg.from_email)
   282	
   283	    stamped = dict(gated)
   284	    stamped["schema"] = "brain.email_extraction/1"
   285	    stamped["summary"] = model_obj.get("summary")
   286	    stamped["cost_usd"] = cost_usd
   287	    stamped["model_receipt"] = model_receipt
   288	    stamped["extracted_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
   289	    stamped["identity"] = extraction_identity(source_ref, digest, slugs)
   290	    stamped["bound_slugs"] = sorted(slugs)
   291	    # G0B2-11: matches_open_item is an INVOCATION-LOCAL index into the context
   292	    # that was sent with THIS call. Persist the mapping alongside the result so
   293	    # a later cache hit can re-resolve those indices against a rebuilt context
   294	    # instead of indexing blindly into a different list.
   295	    stamped["context"] = [
   296	        {"id": item.id, "text": item.text, "owner": item.owner, "source": item.source}
   297	        for item in context
   298	    ]
   299	
   300	    if spent_usd + cost_usd > max_usd:
   301	        raise BudgetExceeded(stamped, spent_usd, max_usd)
   302	    return stamped
   303	
   304	
   305	def rebind_cached_matches(cached: dict[str, Any], context: list[ContextItem]) -> dict[str, Any]:
   306	    """G0B2-11: re-resolve a CACHED extraction's `matches_open_item` indices
   307	    against the context built for THIS invocation.
   308	
   309	    The cached indices point into `cached["context"]` — the list that was sent
   310	    with the paid call. Between then and now an open item can have been closed,
   311	    reordered, or replaced, so the same integer can denote a different item (or
   312	    no item at all). For each commitment we look the ORIGINAL item up in the
   313	    stored mapping, then find that same (text, source) in the current context:
   314	    a hit re-points the index, a miss clears it to None so the commitment is no
   315	    longer tier-2-suppressed against something that is gone. Never raises
   316	    IndexError, and never triggers a new LLM call — the at-most-one-call
   317	    identity stays (source_ref, digest, sorted slugs)."""
   318	    stored = cached.get("context")
   319	    commitments = cached.get("commitments") or []
   320	    if not any(c.get("matches_open_item") is not None for c in commitments):
   321	        return cached
   322	    by_index = {int(item["id"]): item for item in (stored or []) if isinstance(item, dict) and "id" in item}
   323	    current_by_key = {(item.text, item.source): item.id for item in context}
   324	    out = dict(cached)
   325	    rebound: list[dict[str, Any]] = []
   326	    for commitment in commitments:
   327	        idx = commitment.get("matches_open_item")
   328	        if idx is None:
   329	            rebound.append(commitment)
   330	            continue
   331	        entry = dict(commitment)
   332	        original = by_index.get(int(idx))
   333	        new_id = None
   334	        if original is not None:
   335	            new_id = current_by_key.get((original.get("text", ""), original.get("source", "")))
   336	        entry["matches_open_item"] = new_id  # G-EXT-4
   337	        rebound.append(entry)
   338	    out["commitments"] = rebound
   339	    return out
   340	
