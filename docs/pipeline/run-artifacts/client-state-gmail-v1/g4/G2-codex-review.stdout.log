   167	
   168	def _matches_json_type(value: Any, type_name: str) -> bool:
   169	    if type_name == "null":
   170	        return value is None
   171	    if type_name == "integer" and isinstance(value, bool):
   172	        return False
   173	    expected = _JSON_TYPES.get(type_name)
   174	    if expected is None:
   175	        return True
   176	    return isinstance(value, expected)
