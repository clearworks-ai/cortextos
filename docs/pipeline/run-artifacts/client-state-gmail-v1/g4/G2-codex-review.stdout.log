    80	                # bare-label collapse (example.com/example.org -> "example")
    81	                # is exactly the false positive this invariant must not raise.
    82	                pages = domain_pages.setdefault(dom, [])
    83	                if path.stem not in pages:
    84	                    pages.append(path.stem)
    85	
    86	            history = _section_text(path, "History")
    87	            for line in history.splitlines():
    88	                m = _GMAIL_REF_LINE_RE.match(line.strip())
