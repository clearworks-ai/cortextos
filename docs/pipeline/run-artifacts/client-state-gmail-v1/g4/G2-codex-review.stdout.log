   121	            epoch //= 1000
   122	        try:
   123	            dt = datetime.fromtimestamp(epoch, tz=timezone.utc)
   124	        except (OSError, OverflowError, ValueError):
   125	            return ""
   126	    if dt is None:
   127	        try:
   128	            dt = datetime.fromisoformat(raw[:-1] + "+00:00" if raw.endswith("Z") else raw)
