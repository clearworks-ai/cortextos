    96	
    97	    org_name_multi = [
    98	        {"name": v["name"], "pages": sorted(v["pages"])}
    99	        for v in org_pages.values()
   100	        if len(v["pages"]) > 1
   101	    ]
   102	    domain_multi = [
   103	        {"domain": dom, "pages": sorted(pages)}
   104	        for dom, pages in domain_pages.items()
   105	        if len(pages) > 1
   106	    ]
   107	    return {
   108	        "org_name_multi": sorted(org_name_multi, key=lambda r: r["name"]),
   109	        "domain_multi": sorted(domain_multi, key=lambda r: r["domain"]),
   110	        "missing_gmail_refs": sorted(missing_refs, key=lambda r: (r["ref"], r["page"])),
   111	    }
