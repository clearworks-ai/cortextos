   608	            cfg.state_dir, "budget", cost_usd=state.cost,
   609	            message_count=len(messages_raw), truncation=truncation,
   610	            model_receipt=exc.extraction.get("model_receipt"),  # G0B-6
   611	        )
   612	        result.exit_code = 12
   613	        result.cost_usd = state.cost
   614	        result.previews.append(f"budget exceeded: {exc}")
   615	        return result
   616	    except (
   617	        GmailSourceError, extract_email.ExtractionError, client_state_writes.WriterError,
   618	        client_state_writes.TaskEnumerationError, EscalationError, single_flight.LeaseLost,
   619	    ) as exc:
