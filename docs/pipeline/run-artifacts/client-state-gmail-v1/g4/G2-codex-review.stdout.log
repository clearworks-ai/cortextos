   271	def gap_line(receipt: dict | None, window_days: int, now: datetime) -> str | None:
   272	    """FR-002: when the receipt's last_success_at is older than the lookback
   273	    window, return the digest sentence naming the repair (`--days N`,
   274	    N = ceil(days since last_success_at)); else None."""
   275	    if not receipt:
   276	        return None
   277	    last = receipt.get("last_success_at")
   278	    if not last:
   279	        return None
   280	    try:
   281	        last_dt = datetime.fromisoformat(last)
   282	    except ValueError:
   283	        return None
   284	    if last_dt.tzinfo is None:
   285	        last_dt = last_dt.replace(tzinfo=timezone.utc)
   286	    now_dt = now if now.tzinfo is not None else now.replace(tzinfo=timezone.utc)
   287	    delta_days = (now_dt - last_dt).total_seconds() / 86400.0
   288	    if delta_days <= window_days:
   289	        return None
   290	    n = math.ceil(delta_days)  # G-RECEIPT-2: N = ceil(days since last_success_at)
   291	    return (
   292	        f"Gmail poller gap: last success {last} is {n} day(s) old "
   293	        f"(window {window_days}d) -- repair with `--days {n}`."
   294	    )

