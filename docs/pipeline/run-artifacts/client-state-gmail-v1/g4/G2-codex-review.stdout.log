   174	def _atomic_write_text(path: Path, text: str) -> None:
   175	    path.parent.mkdir(parents=True, exist_ok=True)
   176	    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".csw-", suffix=".tmp")
   177	    try:
   178	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   179	            fh.write(text)
   180	        os.replace(tmp, path)
   181	    except BaseException:
   182	        try:
   183	            os.unlink(tmp)
   184	        except OSError:
   185	            pass
   186	        raise
