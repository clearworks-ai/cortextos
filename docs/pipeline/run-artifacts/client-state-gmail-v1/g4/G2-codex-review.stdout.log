   139	def extraction_identity(source_ref: str, digest: str, slugs: list[str]) -> str:
   140	    joined = ",".join(sorted(slugs))
   141	    payload = f"{source_ref}|{digest}|{joined}"
   142	    return hashlib.sha256(payload.encode()).hexdigest()
