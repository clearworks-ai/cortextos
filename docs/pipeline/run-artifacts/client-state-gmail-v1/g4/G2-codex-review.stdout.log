    83	# A2 (binding): the lease must be heartbeated at least every 10 minutes for the
    84	# whole time it is held. 5 minutes gives a 2x margin against a 60-minute TTL.
    85	HEARTBEAT_INTERVAL_S = 300.0
    86	
    87	
    88	@dataclass
    89	class Heartbeat:
    90	    """G0B3-6: a time-bounded heartbeat for the WHOLE acquired interval.
    91	
    92	    Touching once per message is not enough: `gmail_source.sweep` runs before the
    93	    first message and can issue a full-window query plus up to 14 daily ones,
    94	    each through a runner whose default timeout is 120s; and a single message's
    95	    read + extraction + writes have no natural boundary either. Both can outlast
    96	    the staleness window while the run is very much alive.
    97	
    98	    `tick()` is cheap and idempotent — it touches only when at least
    99	    `interval_s` has elapsed on a MONOTONIC clock (injectable, so a test can
   100	    simulate a long sweep without sleeping). Losing the lock raises LeaseLost at
   101	    the next tick, so the run stops before its next effect."""
   102	
   103	    lease: "Lease"
   104	    clock: Callable[[], float] = time.monotonic
   105	    interval_s: float = HEARTBEAT_INTERVAL_S
   106	    _last: float = field(default=0.0, init=False)
   107	    touches: int = field(default=0, init=False)
   108	
   109	    def __post_init__(self) -> None:
   110	        self._last = self.clock()
   111	
   112	    def tick(self) -> None:
   113	        # Liveness is checked on EVERY tick (one stat — negligible next to a
   114	        # subprocess), so loss stops the run immediately rather than up to
   115	        # `interval_s` later. The mtime TOUCH is what is rate-limited.
   116	        if not self.lease.lost and not lock_path(self.lease.claims_dir, self.lease.name).exists():
   117	            self.lease.lost = True
   118	        if self.lease.lost:
   119	            raise LeaseLost(
   120	                "client-state-gmail lease disappeared mid-run — stopping before further writes"
   121	            )
   122	        now = self.clock()
   123	        if now - self._last < self.interval_s:
   124	            return
   125	        self._last = now
   126	        self.lease.touch()          # G-LOCK-8
   127	        self.touches += 1
   128	        if self.lease.lost:
   129	            raise LeaseLost(
   130	                "client-state-gmail lease disappeared mid-run — stopping before further writes"
   131	            )
   132	
   133	
   134	class HeartbeatRunner:
   135	    """Wraps a Runner so EVERY call boundary is a heartbeat opportunity — the
   136	    sweep's per-day queries, each `gws +read`, the `claude` call, and every CRM
   137	    or bus write all go through `Runner.run`, so this is the one place that
   138	    covers them all without threading a callback through six modules."""
   139	
   140	    def __init__(self, inner, heartbeat: "Heartbeat") -> None:
   141	        self.inner = inner
   142	        self.heartbeat = heartbeat
   143	
   144	    @property
   145	    def calls(self):
   146	        return getattr(self.inner, "calls", [])
   147	
   148	    def run(self, argv, *, input=None, env=None, timeout: int = 120):
   149	        self.heartbeat.tick()       # G-LOCK-8: before the call, so a long one is bracketed
   150	        result = self.inner.run(argv, input=input, env=env, timeout=timeout)
   151	        self.heartbeat.tick()       # and after, so the NEXT call starts from a fresh touch
   152	        return result
   153	
   154	
   155	def _claim_argv(claims_dir: Path, name: str, ttl_min: int) -> list[str]:
   156	    return [
   157	        "cortextos",
   158	        "bus",
   159	        "meeting-brief-claim",
   160	        name,
   161	        "--claims-dir",
   162	        str(claims_dir),
   163	        "--ttl-min",
   164	        str(ttl_min),
   165	    ]
   166	
   167	
   168	def acquire(runner: Runner, claims_dir: Path, name: str, ttl_min: int = 60) -> Lease | None:
   169	    argv = _claim_argv(claims_dir, name, ttl_min)
   170	    result = runner.run(argv)
   171	    if result.returncode == 0:
   172	        return Lease(claims_dir=Path(claims_dir), name=name, runner=runner)
   173	    if "stale-cleared" in (result.stderr or ""):
   174	        # The CLI call that DISCOVERS staleness never wins in-band
   175	        # (meeting-brief.ts unlinks the dead holder's lock and reports
   176	        # stale-cleared WITHOUT reclaiming -- two overlapping fires can
   177	        # never both win off this path). Retry ONCE, immediately: the lock
   178	        # is now gone, so the retry's O_CREAT|O_EXCL fast path wins cleanly
   179	        # instead of making the caller wait for its next tick.
   180	        retry = runner.run(argv)
   181	        if retry.returncode == 0:
   182	            return Lease(claims_dir=Path(claims_dir), name=name, runner=runner)  # G-LOCK-4: retry-once wins
   183	        return None
   184	    return None  # G-LOCK-3: plain refusal (already-claimed, still live) -- no retry

