   170	def plan_message_preview(
   171	    msg: Message,
   172	    resolutions: list[Resolution],
   173	    extraction: dict[str, Any] | None,
   174	    *,
   175	    cached: bool,
   176	    crm_lines: list[str],
   177	    page_diffs: list[str],
   178	    task_lines: list[str],
   179	    escalation_text: str | None,
   180	    digest_lines: list[str] | None = None,
   181	) -> str:
   182	    """G4 item 3: the per-message dry-run block carrying EVERY named field --
   183	    source_ref, thread_id, sender (name + email), each resolution's full shape,
   184	    the cached-or-fresh flag, extraction summary + every decision/commitment/
   185	    open_question WITH its grounding quote + matches_open_item, CRM argv
   186	    previews, page unified diff, task lines with dedup verdicts, escalation
   187	    text, cost_usd + model_receipt, and the digest lines this row would
