   150	    schema = EMAIL_SCHEMA_PATH.read_text(encoding="utf-8")
   151	    context_lines = "\n".join(_context_line(item) for item in context) or "(none)"
   152	    return EMAIL_PROMPT_TEMPLATE.format(
