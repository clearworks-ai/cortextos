   549	        return RunResult(exit_code=2, previews=["lock held — another run is in progress"])
   550	
   551	    result = RunResult(exit_code=0)
   552	    ledger = Ledger(cfg.state_dir / "observations.jsonl")
   553	    state = _RunState()
   554	    messages_raw: list[dict] = []
   555	    truncation: list[dict] = []
