    24	class LeaseReleaseError(Exception):
    25	    """The `meeting-brief-release` CLI call failed (non-zero rc, or the
    26	    subprocess never returned). The lock stays held until its TTL expires while
    27	    the run would otherwise report success, so the caller must surface it
    28	    instead of returning 0 (G0B3-11)."""
    29	
    30	
    31	class LeaseLost(Exception):
    32	    """Raised by the caller when `Lease.lost` is set: the lock file this run
    33	    holds has disappeared (a concurrent stale-sweep, or another poller already
    34	    reclaimed it). Single-flight is no longer guaranteed, so the run must STOP
    35	    before any further effect rather than keep writing (G0B2-13)."""
    36	
    37	
    38	@dataclass
    39	class Lease:
    40	    claims_dir: Path
    41	    name: str
    42	    runner: Runner
    43	    lost: bool = False
    44	
    45	    def touch(self) -> None:
    46	        """Heartbeat. If our OWN lock file is gone (src/bus/meeting-brief.ts
    47	        unlinkSync stale-sweep, or another holder reclaimed it) we no longer
    48	        own the lease: mark it lost so the caller stops BEFORE further effects.
    49	        Silently continuing here would let two runs write concurrently and
    50	        would let this run release somebody else's lease (G0B2-13)."""
