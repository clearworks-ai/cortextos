    17	def lock_path(claims_dir: Path, name: str) -> Path:
    18	    # G-LOCK-1: must reproduce src/bus/meeting-brief.ts claimLockPath exactly
    19	    # -- sha256(eventId) hex digest, first 32 chars, "<hash>.lock".
