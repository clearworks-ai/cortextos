   211	def validate_email_extraction(obj: dict[str, Any], n_context: int) -> None:
   212	    """C9 order: (1) typed schema walk; (2) single-line checks; (3) the
   213	    matches_open_item range check."""
   214	    if not isinstance(obj, dict):
   215	        raise ValueError("extraction is not an object")
   216	    _validate_against_email_schema(obj, EMAIL_SCHEMA, "")
   217	
   218	    _require_single_line(obj.get("summary"), "summary")
   219	    for i, dec in enumerate(obj.get("decisions") or []):
   220	        _require_single_line(dec.get("text"), f"decisions[{i}].text")
   221	        _require_single_line(dec.get("quote"), f"decisions[{i}].quote")
   222	    for i, oq in enumerate(obj.get("open_questions") or []):
   223	        _require_single_line(oq.get("text"), f"open_questions[{i}].text")
   224	        _require_single_line(oq.get("quote"), f"open_questions[{i}].quote")
   225	    for i, c in enumerate(obj.get("commitments") or []):
   226	        _require_single_line(c.get("text"), f"commitments[{i}].text")
   227	        _require_single_line(c.get("owner_name"), f"commitments[{i}].owner_name")
   228	        _require_single_line(c.get("quote"), f"commitments[{i}].quote")
   229	
   230	    for i, c in enumerate(obj.get("commitments") or []):
   231	        moi = c.get("matches_open_item")
   232	        if moi is not None and not (1 <= moi <= n_context):  # G-EXT-1: must reference a listed context id
   233	            raise ValueError(f"commitments[{i}].matches_open_item: out of range 1..{n_context}")
