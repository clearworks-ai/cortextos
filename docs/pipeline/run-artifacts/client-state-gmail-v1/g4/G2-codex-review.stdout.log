export function computeDefaultDueDate(
  priority: Priority,
  someday: boolean,
  taskClass: TaskClass | undefined = undefined,
  now: Date = new Date(),
): string {
  // Someday (explicit backlog signal) wins over class caps.
  const days = someday
    ? SOMEDAY_DUE_DAYS
    : Math.min(DEFAULT_DUE_DAYS[priority], CLASS_DUE_DAYS_CAP[taskClass as TaskClass] ?? Infinity);
  return new Date(now.getTime() + days * 86400_000)
    .toISOString()
    .replace(/\.\d{3}Z$/, 'Z');
}

export function isHumanExemptTask(task: Task): boolean {
  return task.assigned_to === 'human'
    || task.assigned_to === 'user'
    || task.project === 'human-tasks'
    || task.type === 'human'
    || RECLAIM_HUMAN_TITLE_RE.test(task.title || '');
}

