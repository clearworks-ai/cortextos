   102	def normalise_date_iso(value: Any) -> str:
   103	    """Every Date form a Gmail payload can carry, reduced to ONE shape:
   104	    `YYYY-MM-DDTHH:MM:SSZ` in UTC.
   105	
   106	    The Gmail-API-native payload's `Date` header is RFC 2822
   107	    ("Sun, 14 Sep 2026 03:00:00 -0700"); the recorded gws +read shape is
   108	    ISO-8601; `internalDate` is an epoch stamp in milliseconds (seconds are
   109	    accepted too). Normalising HERE, at the source, is what makes a downstream
   110	    `date_iso[:10]` a real calendar date -- the RFC 2822 form sliced to
   111	    "Sun, 14 Se" and landed in History entries. A value none of the three
   112	    parsers accepts yields "" rather than a malformed date that reads as real.
   113	    """
   114	    raw = str(value or "").strip()
   115	    if not raw:
   116	        return ""
   117	    dt: datetime | None = None
