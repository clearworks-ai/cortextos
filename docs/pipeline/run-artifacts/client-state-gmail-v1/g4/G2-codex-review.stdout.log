   211	def _superseded_task_ids(ledger: Ledger, row: ObservationRow) -> set[str]:
   212	    # G-SUPER-1 (G0B-15): the digest a revision supersedes can be arbitrarily
   213	    # older than the 24h window this digest covers, so the search reads FULL
   214	    # ledger history (rows_since(_EPOCH_SENTINEL)), never just `rows_since(now
   215	    # - 1 day)` — filtered to the exact row this revision's revision_of names.
   216	    ids: set[str] = set()
   217	    for hist in ledger.rows_since(_EPOCH_SENTINEL):
   218	        if hist.source_ref != row.source_ref or hist.content_digest != row.revision_of:
   219	            continue
   220	        for w in hist.writes:
   221	            if w.startswith("task:"):
   222	                ids.add(_task_id(w))
   223	    return ids
