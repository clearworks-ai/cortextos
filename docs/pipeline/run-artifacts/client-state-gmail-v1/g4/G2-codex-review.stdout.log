   264	def list_messages(runner: "Runner", query: str, max_results: int = 50) -> list[dict]:
   265	    argv = ["gws", "gmail", "+triage", "--query", query, "--format", "json", "--max", str(max_results)]
   266	    proc = runner.run(argv)
   267	    if proc.returncode != 0:
   268	        raise GmailSourceError(f"gws gmail +triage failed rc={proc.returncode}: {proc.stderr.strip()}")  # G-SWEEP-6
   269	    try:
   270	        obj = json.loads(proc.stdout)
   271	    except json.JSONDecodeError as exc:
   272	        raise GmailSourceError(f"gws gmail +triage returned invalid JSON: {exc}") from exc  # G-SWEEP-6
   273	    if isinstance(obj, list):
   274	        return obj
   275	    if isinstance(obj, dict):
   276	        return list(obj.get("messages") or obj.get("emails") or [])  # G-SWEEP-8
   277	    return []
   278	
   279	
   280	def read_message(runner: "Runner", message_id: str) -> Message:
   281	    argv = ["gws", "gmail", "+read", "--id", message_id, "--format", "json"]
   282	    proc = runner.run(argv)
   283	    if proc.returncode != 0:
   284	        raise GmailSourceError(f"gws gmail +read failed rc={proc.returncode}: {proc.stderr.strip()}")  # G-SWEEP-6
   285	    try:
   286	        obj = json.loads(proc.stdout)
   287	    except json.JSONDecodeError as exc:
   288	        raise GmailSourceError(f"gws gmail +read returned invalid JSON: {exc}") from exc  # G-SWEEP-6
   289	    return parse_message(obj)
