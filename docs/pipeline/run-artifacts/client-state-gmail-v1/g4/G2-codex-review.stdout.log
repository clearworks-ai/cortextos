   138	def new_violations(current: dict[str, Any], baseline: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:
   139	    """Items in `current` not present in `baseline`, matched by CANONICAL record:
   140	    (name/domain, sorted page-set tuple) for the two duplicate-declaration
   141	    sections, (ref, page) for missing refs (G-BASE-2 / G0B-14 fix — comparing by
   142	    name/domain KEY ALONE would grandfather a page added to an already-known
   143	    duplicate group, and comparing a missing ref by REF ALONE would grandfather
   144	    the SAME ref later going missing from a DIFFERENT page; the page must be
   145	    part of the identity on both sides)."""
   146	    out: dict[str, list[dict[str, Any]]] = {}
   147	    for section, key_name in (("org_name_multi", "name"), ("domain_multi", "domain")):
   148	        base_canon = {
   149	            (item[key_name], tuple(sorted(item.get("pages", []))))
   150	            for item in baseline.get(section, [])
   151	        }
   152	        out[section] = [
   153	            item
   154	            for item in current.get(section, [])
   155	            if (item[key_name], tuple(sorted(item.get("pages", [])))) not in base_canon
   156	        ]
   157	    base_refs = {(item["ref"], item.get("page")) for item in baseline.get("missing_gmail_refs", [])}
   158	    out["missing_gmail_refs"] = [
   159	        item
   160	        for item in current.get("missing_gmail_refs", [])
   161	        if (item["ref"], item.get("page")) not in base_refs  # G-BASE-2
   162	    ]
   163	    return out
