    44	def _contact_emails(contact: dict[str, Any]) -> list[str]:
    45	    # Mirrors upsert-contact.py:contact_emails exactly (singular "email" field plus
    46	    # the "emails" list, both optional).
    47	    values: list[str] = []
    48	    primary = contact.get("email")
    49	    if isinstance(primary, str):
    50	        values.append(primary)
    51	    stored = contact.get("emails")
    52	    if isinstance(stored, list):
    53	        for item in stored:
    54	            if isinstance(item, str):
    55	                values.append(item)
    56	    return values
