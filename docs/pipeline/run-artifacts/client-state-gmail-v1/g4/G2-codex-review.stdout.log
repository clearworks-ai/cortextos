    59	def _kind_for_slug(closed: dict[str, Any], slug: str) -> str:
    60	    if not slug:
    61	        return ""
    62	    if slug in closed.get("clients", {}):
    63	        return "client"
    64	    if slug in closed.get("orgs", {}):
    65	        return "org"
    66	    if slug in closed.get("nodes", {}):
    67	        return "project"
    68	    return ""
