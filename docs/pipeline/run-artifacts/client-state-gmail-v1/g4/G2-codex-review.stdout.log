    57	def content_digest(subject: str, body_text: str, from_email: str) -> str:
    58	    """sha256 hex of subject/body/from_email, NUL-separated so concatenation
    59	    boundaries can never collide two distinct triples."""
    60	    h = hashlib.sha256()
    61	    h.update(subject.encode("utf-8"))
    62	    h.update(b"\x00")
    63	    h.update(body_text.encode("utf-8"))
    64	    h.update(b"\x00")
    65	    h.update(from_email.encode("utf-8"))
    66	    return h.hexdigest()
