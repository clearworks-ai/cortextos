   136	def plan_digest_line(row: ObservationRow) -> list[str]:
   137	    """FR-009: per-write digest lines INCLUDING the extraction summary, used by
   138	    client_state_digest.gmail_section AND by the dry-run's own digest preview.
   139	    For a simulated row the PLANNED writes are rendered and every line is
   140	    tagged `[simulated]`, so a dry-run digest reports its changes without ever
   141	    claiming they were applied (G0B2-4)."""
   142	    summary = _write_summary(row)
   143	    tag = " [simulated]" if row.simulated else ""
   144	    lines: list[str] = []
   145	    for w in effective_writes(row):
   146	        if w.startswith("crm:"):
   147	            lines.append(f"- CRM: {w} ({row.source_ref}) — {summary}{tag}")
   148	        elif w.startswith("task:"):
   149	            title = w.split("|", 1)[1] if "|" in w else w
   150	            lines.append(f"- Task created: {title} ({row.source_ref}){tag}")
   151	        else:
   152	            lines.append(f"- Page: {w} ({row.source_ref}) — {summary}{tag}")
   153	    for s in row.suppressed:
   154	        lines.append(
   155	            f"- Task suppressed (tier {s['tier']}): {s['title']} matches {s['match']!r} ({row.source_ref}){tag}"
   156	        )
   157	    escalated = [r for r in row.resolutions if r.outcome == "escalated"]
   158	    if escalated:
   159	        # The ESCALATION REASON is carried here rather than a fixed phrase: this
   160	        # is the one renderer of the escalation line (the daily digest used to
   161	        # emit a second, differently-worded one just to keep the reason), so a
   162	        # reader of either consumer sees WHY it escalated.
   163	        reasons = "; ".join(r.reason for r in escalated if r.reason) or "ambiguous entity binding"
   164	        lines.append(f"- Escalated: {row.source_ref} — {reasons}{tag}")
   165	    if row.revision_of:
   166	        lines.append(f"- Revision: {row.source_ref} supersedes {row.revision_of[:8]}{tag}")
   167	    return lines
