   538	def run(cfg: Config, runner) -> RunResult:
   539	    cfg.state_dir.mkdir(parents=True, exist_ok=True)
   540	    claims_dir = cfg.state_dir / "claims"
   541	    lease = single_flight.acquire(runner, claims_dir, "client-state-gmail", ttl_min=60)
