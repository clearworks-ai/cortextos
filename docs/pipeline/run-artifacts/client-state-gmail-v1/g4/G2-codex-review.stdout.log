   292	def sweep(
   293	    runner: "Runner", days: int, today: date, extra_query: str | None = None
   294	) -> tuple[list[dict], list[dict]]:
   295	    """Runs the full-window query first (composed as <extra_query> <date ops>
   296	    <EXCLUSION_QUERY> per C5 — the manual backfill's --query clause never bypasses the
   297	    exclusion filter or date bounds). WHEN it returns fewer than 50 rows THE window is
   298	    complete and no sweep is needed. WHEN it returns exactly 50 (G-SWEEP-2) THE SYSTEM
   299	    day-sweeps the FULL window (one query per calendar day, each composed the same way,
   300	    not a narrowed tail), unions rows by id, and reports every day that itself returned
   301	    50 ({"day": label, "count": 50}) while still including that day's 50 rows
   302	    (G-SWEEP-3) — bounded, reported loss on a freak day, never an uncovered remainder."""
   303	    start = today - timedelta(days=days - 1)
   304	    end = today + timedelta(days=1)
   305	    full_query = _compose_query(_date_ops(start, end), extra_query)
   306	    full = list_messages(runner, full_query, max_results=50)
   307	    if len(full) < 50:
   308	        return full, []
   309	
   310	    seen: dict[str, dict] = {}
   311	    truncation: list[dict] = []
   312	    for offset in range(days - 1, -1, -1):  # G-SWEEP-2
   313	        day = today - timedelta(days=offset)
   314	        label = day.strftime("%Y-%m-%d")
   315	        query = _compose_query(_date_ops(day, day + timedelta(days=1)), extra_query)
   316	        rows = list_messages(runner, query, max_results=50)
   317	        if len(rows) == 50:
   318	            truncation.append({"day": label, "count": 50})  # G-SWEEP-3
   319	        for row in rows:
   320	            mid = str(row.get("id", ""))
   321	            if mid and mid not in seen:
   322	                seen[mid] = row
   323	    return list(seen.values()), truncation

