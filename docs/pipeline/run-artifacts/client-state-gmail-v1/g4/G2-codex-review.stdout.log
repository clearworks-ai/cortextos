    92	class Ledger:
    93	    def __init__(self, path: Path) -> None:
    94	        self.path = Path(path)
    95	
    96	    def _read_rows(self) -> list[ObservationRow]:
    97	        if not self.path.exists():
    98	            return []
    99	        text = self.path.read_text(encoding="utf-8")
   100	        rows: list[ObservationRow] = []
   101	        for line in text.splitlines():
   102	            line = line.strip()
   103	            if not line:
   104	                continue
   105	            rows.append(_row_from_dict(json.loads(line)))
   106	        return rows
   107	
   108	    def append(self, row: ObservationRow) -> None:
   109	        rows = self._read_rows()
   110	        rows.append(row)
   111	        lines = [json.dumps(_row_to_dict(r), sort_keys=True) for r in rows]
   112	        data = ("\n".join(lines) + "\n").encode("utf-8") if lines else b""
   113	        atomic_write(self.path, data)  # G-LEDGER-1: read-whole + rewrite-whole, never a bare open("a")
   114	
   115	    def all_rows(self) -> list[ObservationRow]:
   116	        """Every row, oldest first -- the full history, for consumers that must
   117	        not settle for the LATEST row per ref (the FR-006 coverage diff)."""
   118	        return self._read_rows()
   119	
   120	    def latest(self, source_ref: str) -> ObservationRow | None:
   121	        result: ObservationRow | None = None
   122	        for row in self._read_rows():
   123	            if row.source_ref == source_ref:
   124	                result = row
   125	        return result
