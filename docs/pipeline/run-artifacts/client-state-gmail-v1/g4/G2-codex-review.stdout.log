   149	    def resolve_message(self, msg: Any) -> list[Resolution]:
   150	        r_sender = self.resolve_address(msg.from_email)
   151	        if r_sender.outcome == "ignored":
   152	            # FR-003: sender gates -- an unknown sender means nothing on the
   153	            # message is filed, regardless of who else is on it.
   154	            return [r_sender]
