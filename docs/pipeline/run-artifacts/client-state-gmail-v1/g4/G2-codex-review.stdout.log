   570	        closed = load_closed_sets(cfg.vault)
   571	        resolver = resolve_email.EmailResolver(closed, contacts)
   572	
   573	        for raw in messages_raw:
   574	            # G0B2-13: one more liveness check at the message boundary. The
   575	            # heartbeat wrapper already ticks on every runner call; this makes
   576	            # the stop condition explicit at the point where the next message's
   577	            # effects would begin, and raises LeaseLost if the lock is gone.
   578	            heartbeat.tick()
