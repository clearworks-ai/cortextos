   101	def build_context(open_items: list[dict[str, Any]], open_task_titles: list[str]) -> list[ContextItem]:
   102	    items: list[ContextItem] = []
   103	    next_id = 1
   104	    for row in open_items:
   105	        items.append(
   106	            ContextItem(
   107	                id=next_id,
   108	                text=str(row.get("item") or ""),
   109	                owner=str(row.get("owner") or ""),
   110	                source=str(row.get("source") or ""),
   111	            )
   112	        )
   113	        next_id += 1
   114	    for title in open_task_titles:
   115	        items.append(ContextItem(id=next_id, text=str(title), owner="", source="task"))
   116	        next_id += 1
