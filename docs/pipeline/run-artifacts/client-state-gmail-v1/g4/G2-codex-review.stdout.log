   236	def _claude_failure_reason(proc: Any) -> str:
   237	    # Deviation: duplicated locally rather than imported — see Task 10.
   238	    if proc.stdout:
   239	        try:
   240	            wrapper = json.loads(proc.stdout)
   241	            if isinstance(wrapper, dict) and wrapper.get("result"):
   242	                return str(wrapper["result"])
   243	        except json.JSONDecodeError:
   244	            pass
   245	    return (proc.stderr or "").strip() or f"claude exit {proc.returncode}"
