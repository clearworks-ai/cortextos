              "segment": {
                "endIndex": 895,
                "startIndex": 763,
                "text": "Advisor Labs focuses on workflows that impact margin, such as RFP response, RFI triage, submittal review, and conceptual estimating."
              }
            },
            {
              "groundingChunkIndices": [
                0
              ],
              "segment": {
                "endIndex": 1301,
                "startIndex": 1175,
                "text": "Their consultants possess deep industry knowledge of BIM environments, project delivery methods, and design technology stacks."
              }
            },
            {
              "groundingChunkIndices": [
                0,
                1
              ],
              "segment": {
                "endIndex": 1651,
                "startIndex": 1524,
                "text": "They emphasize turning scattered experiments into implementation that genuinely changes how work is performed within AEC firms."
              }
            },
            {
              "groundingChunkIndices": [
                2
              ],
              "segment": {
                "endIndex": 1843,
                "startIndex": 1652,
                "text": "*   **AEC Hub** assists AEC firms in discovering, implementing, and mastering AI tools to save time, boost productivity, and modernize workflows, all without the typical enterprise price tag."
              }
            },
            {
              "groundingChunkIndices": [
                3
              ],
              "segment": {
                "endIndex": 2178,
                "startIndex": 2016,
                "text": "They offer product discovery and strategy, custom AI product development, and deployment and integration services, ensuring clients own the intellectual property."
              }
            },
            {
              "groundingChunkIndices": [
                4
              ],
              "segment": {
                "endIndex": 2459,
                "startIndex": 2363,
                "text": "Their approach is customized to each firm's unique needs, resources, and organizational culture."
              }
            },
            {
              "groundingChunkIndices": [
                5
              ],
              "segment": {
                "endIndex": 2705,
                "startIndex": 2461,
                "text": "Other firms like RTS Labs and AI Smart Ventures also cater to mid-sized companies across various industries, focusing on practical AI guidance, automating routine tasks, and offering boutique approaches for faster time-to-value and lower costs."
              }
            },
            {
              "groundingChunkIndices": [
                6
              ],
              "segment": {
                "endIndex": 2880,
                "startIndex": 2706,
                "text": "Similarly, MidMarket AI specifically helps mid-sized businesses adopt and implement AI tools to enhance performance and integrate solutions into existing operational systems."
              }
            },
