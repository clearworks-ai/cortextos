              "groundingChunkIndices": [
                7
              ],
              "segment": {
                "endIndex": 3066,
                "startIndex": 2881,
                "text": "These consultants understand the need for flexible, cost-effective solutions that can be rapidly deployed and integrated without extensive disruption for small and mid-sized businesses."
              }
            }
