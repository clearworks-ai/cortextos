              ],
              "segment": {
                "endIndex": 1509,
                "startIndex": 1391,
                "text": "*   Civix completed servicing iterations for 210 Auckland lots in under an hour for the Selo Land Development project."
              }
            },
            {
              "groundingChunkIndices": [
                2,
                5,
                6
              ],
              "segment": {
                "endIndex": 1880,
                "startIndex": 1511,
                "text": "While other firms like YegaTech offer case studies that highlight \"Real Firms, Real Outcomes\" and provide client testimonials, the initial search results for YegaTech's published case studies generally present more qualitative benefits such as improving data quality, establishing a repeatable innovation process, or moving from AI apprehension to a firm-wide strategy."
              }
            },
            {
              "groundingChunkIndices": [
