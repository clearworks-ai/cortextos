{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearworks.ai/contracts/briefs-meeting-intelligence-output-v1.schema.json",
  "title": "BriefsMeetingIntelligenceOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "orgId", "outputId", "outputDigest", "generatedAt", "coverage", "cSurface", "bSurface", "cToBLinks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "orgId": { "type": "string", "minLength": 1 },
    "outputId": { "type": "string", "minLength": 1 },
    "outputDigest": { "$ref": "#/$defs/sha256" },
    "generatedAt": { "$ref": "#/$defs/dateTime" },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["coverageSnapshotId", "snapshotDigest", "evaluationClockDigest", "freshnessState", "asOf"],
      "properties": {
        "coverageSnapshotId": { "type": "string", "minLength": 1 },
        "snapshotDigest": { "$ref": "#/$defs/sha256" },
        "evaluationClockDigest": { "$ref": "#/$defs/sha256" },
        "freshnessState": { "enum": ["current", "stale"] },
        "asOf": { "$ref": "#/$defs/dateTime" }
      }
    },
    "cSurface": {
      "type": "object", "additionalProperties": false,
      "required": ["aggregateId", "title", "numerator", "denominator", "rate", "drillThroughMeetingIds", "drillThroughDigest", "tieBreakPolicy", "ranking", "meetingCards"],
      "properties": {
        "aggregateId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "drillThroughMeetingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "drillThroughDigest": { "$ref": "#/$defs/sha256" },
        "tieBreakPolicy": { "const": "movement_score_desc_then_canonical_meeting_id_asc" },
        "ranking": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["canonicalMeetingId", "movementScore", "occurredAt"],
            "properties": {
              "canonicalMeetingId": { "type": "string", "minLength": 1 },
              "movementScore": { "type": "number" },
              "occurredAt": { "$ref": "#/$defs/dateTime" }
            }
          }
        },
        "meetingCards": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["canonicalMeetingId", "recordDigest", "bPath", "linkDigest"],
            "properties": {
              "canonicalMeetingId": { "type": "string", "minLength": 1 },
              "recordDigest": { "$ref": "#/$defs/sha256" },
              "bPath": { "type": "string", "pattern": "^/business/crm/meetings/" },
              "linkDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "bSurface": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalMeetingId", "recordVersion", "recordDigest", "title", "claimLabels", "sourceEvidence", "sections", "freshnessState", "asOf", "cPath"],
      "properties": {
        "canonicalMeetingId": { "type": "string", "minLength": 1 },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "recordDigest": { "$ref": "#/$defs/sha256" },
        "title": { "type": "string", "minLength": 1 },
        "claimLabels": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["canonicalClaimId", "claimId", "label", "disposition", "semanticClass", "evidenceRefs"],
            "properties": {
              "canonicalClaimId": { "type": "string", "minLength": 1 },
              "claimId": { "type": "string", "minLength": 1 },
              "label": { "enum": ["fact", "inference", "proposal"] },
              "disposition": { "enum": ["accepted", "proposed", "rejected", "superseded"] },
              "semanticClass": { "type": "string", "minLength": 1 },
              "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "sourceEvidence": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidenceId", "sourceId", "artifactId", "quoteDigest", "sourceLineageDigest"],
            "properties": {
              "evidenceId": { "type": "string", "minLength": 1 },
              "sourceId": { "type": "string", "minLength": 1 },
              "artifactId": { "type": "string", "minLength": 1 },
              "quoteDigest": { "$ref": "#/$defs/sha256" },
              "sourceLineageDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "sections": {
          "type": "object", "additionalProperties": false,
          "required": ["structuredSummary", "participants", "topics", "decisions", "discovery", "changes", "commitmentsDates", "lifecycle", "followUpDraft", "artifactsEvidence", "recurringThemes", "sinkReceiptsFreshness"],
          "properties": {
            "structuredSummary": { "type": "object" }, "participants": { "type": "array", "minItems": 1 },
            "topics": { "type": "object" }, "decisions": { "type": "object" }, "discovery": { "type": "object" }, "changes": { "type": "object" },
            "commitmentsDates": { "type": "object" }, "lifecycle": { "type": "object" }, "followUpDraft": { "type": "object" },
            "artifactsEvidence": { "type": "object" }, "recurringThemes": { "type": "object" }, "sinkReceiptsFreshness": { "type": "object" }
          }
        },
        "freshnessState": { "enum": ["current", "stale"] },
        "asOf": { "$ref": "#/$defs/dateTime" },
        "cPath": { "const": "/business/crm/meetings" }
      }
    },
    "cToBLinks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["canonicalMeetingId", "recordDigest", "fromPath", "toPath", "linkDigest"],
        "properties": {
          "canonicalMeetingId": { "type": "string", "minLength": 1 },
          "recordDigest": { "$ref": "#/$defs/sha256" },
          "fromPath": { "const": "/business/crm/meetings" },
          "toPath": { "type": "string", "pattern": "^/business/crm/meetings/" },
          "linkDigest": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" }
  }
}
