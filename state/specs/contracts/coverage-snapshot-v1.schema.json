{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearworks.ai/contracts/coverage-snapshot-v1.schema.json",
  "title": "CoverageSnapshotV1",
  "description": "Immutable aggregate-coverage statement. snapshotDigest is SHA-256 of RFC 8785 JCS bytes after removing only snapshotDigest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "orgId",
    "coverageSnapshotId",
    "snapshotDigest",
    "generatedAt",
    "evaluationClockDigest",
    "freshness",
    "channels",
    "windowStart",
    "windowEnd",
    "cutoffAt",
    "enumerationState",
    "cursor",
    "checkpointDigest",
    "sourceDigest",
    "sourceIds",
    "recordSetDigest",
    "recordIds",
    "counts",
    "gaps",
    "enumerationAuthority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "orgId": {
      "type": "string",
      "minLength": 1
    },
    "coverageSnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotDigest": {
      "$ref": "#/$defs/sha256"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evaluationClockDigest": {
      "$ref": "#/$defs/sha256"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "evaluatedAsOf",
        "state",
        "snapshotAgeSeconds",
        "sourceLagSeconds",
        "receiptDigest"
      ],
      "properties": {
        "policyVersion": { "const": "coverage-freshness-v1" },
        "evaluatedAsOf": { "$ref": "#/$defs/dateTime" },
        "state": { "enum": ["current", "stale", "future"] },
        "snapshotAgeSeconds": { "type": "integer", "minimum": 0 },
        "sourceLagSeconds": { "type": "integer", "minimum": 0 },
        "receiptDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fireflies"
        ]
      }
    },
    "windowStart": {
      "type": "string",
      "format": "date-time"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time"
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time"
    },
    "enumerationState": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpointDigest": {
      "$ref": "#/$defs/sha256"
    },
    "sourceDigest": {
      "$ref": "#/$defs/sha256"
    },
    "recordSetDigest": {
      "$ref": "#/$defs/sha256"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered",
        "processed",
        "quarantined",
        "unresolved",
        "excluded"
      ],
      "properties": {
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "processed": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gapId",
          "kind",
          "sourceId",
          "reason",
          "blocking"
        ],
        "properties": {
          "gapId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fetch_failed",
              "evidence_missing",
              "identity_ambiguous",
              "record_failed",
              "excluded_policy"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recordIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enumerationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "policyVersion",
        "receiptDigest"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "receiptDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enumerationState": {
            "const": "complete"
          }
        },
        "required": [
          "enumerationState"
        ]
      },
      "then": {
        "properties": {
          "cursor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "enumerationState": {
            "const": "partial"
          }
        },
        "required": [
          "enumerationState"
        ]
      },
      "then": {
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
