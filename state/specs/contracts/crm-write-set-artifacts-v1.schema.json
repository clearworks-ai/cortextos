{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearworks.ai/contracts/crm-write-set-artifacts-v1.schema.json",
  "title": "CrmWriteSetArtifactsV1",
  "description": "Governed request and durable-intent collection for one CrmWriteSetV1; members are independently checked against their versioned contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "orgId", "writeSetId", "canonicalMeetingId", "recordVersion", "recordDigest", "requests", "intents"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "orgId": { "type": "string", "minLength": 1 },
    "writeSetId": { "type": "string", "minLength": 1 },
    "canonicalMeetingId": { "type": "string", "minLength": 1 },
    "recordVersion": { "type": "integer", "minimum": 1 },
    "recordDigest": { "$ref": "#/$defs/sha256" },
    "requests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object" } },
    "intents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
