{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearworks.ai/contracts/semantic-evaluation-v1.schema.json",
  "title": "SemanticEvaluationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "orgId", "evaluationId", "evaluationDigest", "datasetDigest", "metricReceiptDigest", "policyVersion", "requiredDimensions", "meetingSplit", "thresholdPolicy", "strata", "counterexamples", "rankingTieBreakPolicy", "overallStatus"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "orgId": { "type": "string", "minLength": 1 },
    "evaluationId": { "type": "string", "minLength": 1 },
    "evaluationDigest": { "$ref": "#/$defs/sha256" },
    "datasetDigest": { "$ref": "#/$defs/sha256" },
    "metricReceiptDigest": { "$ref": "#/$defs/sha256" },
    "policyVersion": { "const": "meeting-semantic-evaluation-v1" },
    "requiredDimensions": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": { "enum": ["direction", "work_state", "evidence_grounding", "due", "dependency", "context_class", "identity"] }
    },
    "meetingSplit": {
      "type": "object", "additionalProperties": false,
      "required": ["policyVersion", "trainingMeetingIds", "evaluationMeetingIds", "splitDigest"],
      "properties": {
        "policyVersion": { "const": "meeting-level-holdout-v1" },
        "trainingMeetingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evaluationMeetingIds": { "type": "array", "minItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "splitDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "thresholdPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumPositive", "minimumNegative", "minimumPrecision", "minimumRecall", "minimumAccuracy", "minimumConfidenceLowerBound"],
      "properties": {
        "minimumPositive": { "const": 8 },
        "minimumNegative": { "const": 8 },
        "minimumPrecision": { "const": 0.95 },
        "minimumRecall": { "const": 0.9 },
        "minimumAccuracy": { "const": 0.9 },
        "minimumConfidenceLowerBound": { "const": 0.9 }
      }
    },
    "strata": {
      "type": "array", "minItems": 7, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "stratumId", "positiveMeetingIds", "negativeMeetingIds", "truePositive", "falsePositive", "falseNegative", "trueNegative", "precision", "recall", "accuracy", "f1", "support", "confidenceLowerBound", "status"],
        "properties": {
          "dimension": { "enum": ["direction", "work_state", "evidence_grounding", "due", "dependency", "context_class", "identity"] },
          "stratumId": { "type": "string", "minLength": 1 },
          "positiveMeetingIds": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "negativeMeetingIds": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "truePositive": { "type": "integer", "minimum": 0 },
          "falsePositive": { "type": "integer", "minimum": 0 },
          "falseNegative": { "type": "integer", "minimum": 0 },
          "trueNegative": { "type": "integer", "minimum": 0 },
          "precision": { "type": "number", "minimum": 0, "maximum": 1 },
          "recall": { "type": "number", "minimum": 0, "maximum": 1 },
          "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
          "f1": { "type": "number", "minimum": 0, "maximum": 1 },
          "support": { "type": "integer", "minimum": 0 },
          "confidenceLowerBound": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "enum": ["pass", "fail", "not_proven"] }
        }
      }
    },
    "counterexamples": {
      "type": "array", "minItems": 7, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["counterexampleId", "stratumId", "meetingId", "kind", "expectedLabel", "predictedLabel", "evidenceId", "drillThroughPath"],
        "properties": {
          "counterexampleId": { "type": "string", "minLength": 1 },
          "stratumId": { "type": "string", "minLength": 1 },
          "meetingId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["hard_positive", "hard_negative", "false_positive", "false_negative"] },
          "expectedLabel": { "type": "string", "minLength": 1 },
          "predictedLabel": { "type": "string", "minLength": 1 },
          "evidenceId": { "type": "string", "minLength": 1 },
          "drillThroughPath": { "type": "string", "pattern": "^/business/crm/meetings/" }
        }
      }
    },
    "rankingTieBreakPolicy": { "const": "score_desc_then_canonical_meeting_id_asc" },
    "overallStatus": { "enum": ["pass", "fail", "not_proven"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
