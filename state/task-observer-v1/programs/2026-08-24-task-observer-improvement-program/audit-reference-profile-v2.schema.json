{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["profile_id","profile_version","required_sections","coverage_thresholds","reference_artifacts"],
  "properties":{
    "profile_id":{"type":"string","pattern":"^[a-z0-9-]+$"},
    "profile_version":{"type":"integer","minimum":1},
    "required_sections":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "coverage_thresholds":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "reference_artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["artifact_id","relative_path","sha256"],"properties":{"artifact_id":{"type":"string"},"relative_path":{"type":"string","pattern":"^(?!/|.*\\.\\.).+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
  }
}
