+  async findEngagementByAttendeeEmails(orgId: string, emails: string[]): Promise<number | null> {
+    if (emails.length === 0) return null;
+    
+    // Case-insensitive email match against clientPeople
+    const lowercasedEmails = emails.map(e => e.toLowerCase().trim());
+    
+    const matchingPeople = await db.select()
+      .from(clientPeople)
+      .where(
+        and(
+          eq(clientPeople.orgId, orgId),
+          sql`${clientPeople.email} IS NOT NULL`,
+          sql`LOWER(${clientPeople.email}) = ANY(${lowercasedEmails})`
+        )
+      );
+    
+    if (matchingPeople.length === 0) return null;
+    
+    // Return the most common engagementId among matching people
+    const engagementCounts = new Map<number, number>();
+    for (const person of matchingPeople) {
+      if (person.engagementId) {
+        const count = engagementCounts.get(person.engagementId) || 0;
+        engagementCounts.set(person.engagementId, count + 1);
+      }
+    }
+    
+    if (engagementCounts.size === 0) return null;
+    
+    // Find the engagementId with the highest count
+    let maxCount = 0;
+    let bestEngagementId: number | null = null;
+    for (const [engagementId, count] of Array.from(engagementCounts.entries())) {
+      if (count > maxCount) {
+        maxCount = count;
+        bestEngagementId = engagementId;
+      }
+    }
+    
+    return bestEngagementId;
+  }
