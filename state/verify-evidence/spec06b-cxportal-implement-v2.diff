+export const requireMeetingIngestSecret: RequestHandler = (req, res, next) => {
+  const secretHeader = req.headers['x-meeting-ingest-secret'];
+  const providedSecret = Array.isArray(secretHeader) ? secretHeader[0] : secretHeader;
+  const expectedSecret = process.env.MEETING_INGEST_SECRET;
+  
+  if (!expectedSecret) {
+    console.error('MEETING_INGEST_SECRET environment variable is not set');
+    return res.status(500).json({ message: "Server configuration error" });
+  }
+  
+  if (!providedSecret) {
+    return res.status(401).json({ message: "Missing secret header" });
+  }
+  
+  try {
+    if (!timingSafeEqual(Buffer.from(providedSecret), Buffer.from(expectedSecret))) {
+      return res.status(401).json({ message: "Invalid secret" });
+    }
+  } catch {
+    return res.status(401).json({ message: "Invalid secret" });
+  }
+  
+  next();
+};
