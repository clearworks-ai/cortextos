+        open_items = markdown_open_items(sections.get("open items", []))
+        detail_parts = [
+            f"This meeting's attendees map to client={client_name}.",
+            f"Deal stage={stage}.",
+            f"CRM status={status}.",
+            f"Engagement={engagement}.",
+        ]
+        if service_type:
+            detail_parts.append(f"Service={service_type}.")
+        if relationship_context:
